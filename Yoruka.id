local function lowerText(v) return string.lower(tostring(v or "")) end
local function containsAny(t, needles) t=lowerText(t); for _,n in ipairs(needles) do if string.find(t,n,1,true) then return true end end; return false end
local function cleanText(v, fb) local x=tostring(v or ""):gsub("%s+"," "):match("^%s*(.-)%s*$"); return x and x~="" and x or fb or "-" end
local function isGuiVisible(gui)
	if not (gui and gui:IsA("GuiObject") and gui.Visible and gui:IsDescendantOf(playerGui)) then return false end
	local p = gui.Parent
	while p and p ~= playerGui do
		if p:IsA("GuiObject") and not p.Visible then return false end
		if p:IsA("LayerCollector") and not p.Enabled then return false end
		p = p.Parent
	end
	return true
end
local function clickGuiButton(b)
	if not (b and b:IsA("GuiButton") and isGuiVisible(b)) then return false end
	local c = b.AbsolutePosition + b.AbsoluteSize/2
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(c.X,c.Y,0,true,game,0); task.wait(0.035)
		VirtualInputManager:SendMouseButtonEvent(c.X,c.Y,0,false,game,0)
	end)
end
local function pressButton(b)
	if not (b and b:IsA("GuiButton") and isGuiVisible(b)) then return false end
	if type(firesignal)=="function" then
		if pcall(firesignal,b.MouseButton1Click) then return true end
		if pcall(firesignal,b.Activated) then return true end
	end
	return clickGuiButton(b)
end
local function getCharacter()
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health>0 and char.Parent then
		if hum:GetStateEnabled(Enum.HumanoidStateType.Seated) then hum:SetStateEnabled(Enum.HumanoidStateType.Seated,false) end
		if hum.Sit then hum.Sit=false; hum:ChangeState(Enum.HumanoidStateType.Running) end
		return char,hum,root
	end
	return nil,nil,nil
end
local function cancelMovement()
	local _,hum,root = getCharacter()
	if hum and root then hum:MoveTo(root.Position); pcall(function() root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero end) end
end
local function setStatus(msg,ex)
	ex=ex or {}; State.Status.Message=cleanText(msg,"Active")
	if ex.Phase then State.Status.Phase=ex.Phase end
	State.Status.UpdatedAt=os.clock(); State.LastHeartbeatAt=os.clock()
end
local function saveConfig()
	if type(writefile)~="function" then return end
	local d={AutoFarm=State.AutoFarm,AutoStartSolo=State.AutoStartSolo,AutoMinigame=State.AutoMinigame,Noclip=State.Noclip,TweenMode=State.TweenMode,ShiftsCompleted=State.Stats.ShiftsCompleted,MinigamesSolved=State.Stats.MinigamesSolved}
	pcall(writefile,State.ConfigPath,HttpService:JSONEncode(d))
end
local function loadConfig()
	if type(readfile)~="function" or type(isfile)~="function" then return end
	local ok,ex=pcall(isfile,State.ConfigPath)
	if ok and ex then
		local ok2,c=pcall(readfile,State.ConfigPath)
		if ok2 and type(c)=="string" and c~="" then
			local ok3,s=pcall(HttpService.JSONDecode,HttpService,c)
			if ok3 and type(s)=="table" then
				if type(s.AutoFarm)=="boolean" then State.AutoFarm=s.AutoFarm end
				if type(s.AutoStartSolo)=="boolean" then State.AutoStartSolo=s.AutoStartSolo end
				if type(s.AutoMinigame)=="boolean" then State.AutoMinigame=s.AutoMinigame end
				if type(s.Noclip)=="boolean" then State.Noclip=s.Noclip end
				if type(s.TweenMode)=="boolean" then State.TweenMode=s.TweenMode end
				if type(s.ShiftsCompleted)=="number" then State.Stats.ShiftsCompleted=s.ShiftsCompleted end
				if type(s.MinigamesSolved)=="number" then State.Stats.MinigamesSolved=s.MinigamesSolved end
			end
		end
	end
end
local function queueReexecOnTeleport()
	local q = getgenv and getgenv().queue_on_teleport or syn and syn.queue_on_teleport or queue_on_teleport
	if type(q)=="function" then pcall(q,[[task.spawn(function() repeat task.wait(0.5) until game:IsLoaded() and game.Players.LocalPlayer local p={"MorgueMini.lua"} if type(readfile)=="function" and type(isfile)=="function" then for _,x in ipairs(p) do if isfile(x) then loadstring(readfile(x))() break end end end end)]]) end
end
local function releasePromptHold()
	local ap,ak,ph,pr,par,paa = State.ActivePrompt,State.ActivePromptKey,State.PromptHoldHumanoid,State.PromptHoldRoot,State.PromptOriginalAutoRotate,State.PromptOriginalAnchored
	if ap and ap.Parent then pcall(function() ap:InputHoldEnd() end) end
	if ak and ak~=Enum.KeyCode.Unknown then pcall(function() VirtualInputManager:SendKeyEvent(false,ak,false,game) end) end
	pcall(function() VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.E,false,game) end)
	if not (ph and ph.Parent and pr and pr.Parent) then local _,h,r=getCharacter(); ph=h; pr=r end
	if pr and pr.Parent then pcall(function()
		if paa~=nil then pr.Anchored=paa end
		pr.AssemblyLinearVelocity=Vector3.zero; pr.AssemblyAngularVelocity=Vector3.zero
	end) end
	if ph and ph.Parent then ph.AutoRotate = par~=nil and par or true end
	State.ActivePrompt=nil; State.ActivePromptKey=nil; State.PromptHoldHumanoid=nil; State.PromptHoldRoot=nil
	State.PromptOriginalAutoRotate=nil; State.PromptOriginalAnchored=nil; State.PromptBusy=false
end
local function applyNoclipOnce(char)
	if not State.Noclip or not char then return end
	for _,d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") and d.CanCollide then d.CanCollide=false end end
end
local function startNoclipLoop()
	table.insert(State.Connections,RunService.Heartbeat:Connect(function()
		if not State.Noclip or State.Unloaded then return end
		local char = localPlayer.Character; if char then applyNoclipOnce(char) end
	end))
end
local function walkToPosition(targetPos,timeout,tolerance)
	local char,hum,root = getCharacter(); if not (char and hum and root) then return false end
	timeout=timeout or State.WalkTimeout; tolerance=tolerance or 4
	pcall(function() if root.Anchored then root.Anchored=false end end)
	if (root.Position-targetPos).Magnitude<=tolerance then return true end
	hum:MoveTo(targetPos)
	local st=os.clock(); local lastPos=root.Position; local stuckT=0; local direct=false
	while os.clock()-st<timeout do
		if State.Unloaded then break end
		local c,h,r=getCharacter(); if not (c and h and r) then break end
		if h.Health<=0 then break end
		if r.Anchored then pcall(function() r.Anchored=false end) end
		if (r.Position-targetPos).Magnitude<=tolerance then h:Move(Vector3.zero); return true end
		if (r.Position-lastPos).Magnitude<0.3 then
			stuckT+=0.1
			if stuckT>1 then if not direct then direct=true else h.Jump=true end; stuckT=0 end
		else stuckT=0 end
		lastPos=r.Position
		if direct then local d=targetPos-r.Position; if d.Magnitude>0.1 then h:Move(d.Unit) end
		else h:MoveTo(targetPos) end
		if State.Noclip then applyNoclipOnce(c) end
		task.wait(0.1)
	end
	local _,h2=getCharacter(); if h2 then h2:Move(Vector3.zero) end
	return false
end
local function tweenToPosition(targetPos,timeout,tolerance)
	local char,hum,root = getCharacter(); if not (char and hum and root) then return false end
	timeout=timeout or State.WalkTimeout; tolerance=tolerance or 4
	if (root.Position-targetPos).Magnitude<=tolerance then return true end
	local sp=root.Position; local baseCF=root.CFrame
	local dist=(sp-targetPos).Magnitude; local dur=math.min(dist/(State.TweenSpeed or 18),timeout); local st=os.clock()
	while os.clock()-st<dur do
		if State.Unloaded then break end
		local c,h,r=getCharacter(); if not (c and h and r) then break end
		if h.Health<=0 then break end
		local t=math.min((os.clock()-st)/dur,1)
		local np=sp:Lerp(targetPos,t)
		pcall(function() r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero; r.CFrame=CFrame.new(np)*(baseCF-baseCF.Position) end)
		if State.Noclip then applyNoclipOnce(c) end
		task.wait(0.03)
	end
	local _,_,r2=getCharacter(); if r2 then pcall(function() r2.CFrame=CFrame.new(targetPos)*(baseCF-baseCF.Position) end) end
	return true
end
local function moveToPosition(targetPos,timeout,tolerance) if State.TweenMode then return tweenToPosition(targetPos,timeout,tolerance) end return walkToPosition(targetPos,timeout,tolerance) end
local function getPromptPart(prompt)
	local p = prompt and prompt.Parent
	while p and p~=workspace do
		if p:IsA("BasePart") then return p end
		if p:IsA("Model") then local pp=p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart",true); if pp then return pp end end
		p=p.Parent
	end
end
local function getPromptPosition(prompt,part)
	local p = prompt and prompt.Parent
	if p and p:IsA("Attachment") then return p.WorldPosition end
	return part and part.Position
end
local function getFullName(inst)
	if not (inst and inst.Parent) then return "-" end
	local ok,n = pcall(function() return inst:GetFullName() end)
	return ok and cleanText(n,"-") or "-"
end
local function getPromptStandCFrame(prompt) if lowerText(getFullName(prompt))=="workspace.ruangpenyiapan.tools.fluid.proximityprompt" then return fluidStandCFrame end return nil end
local function isInActiveTrolley(inst) local s=workspace:FindFirstChild("Story"); local at=s and s:FindFirstChild("ActiveTrolley"); return at~=nil and inst~=nil and inst:IsDescendantOf(at) end
local function isJumpscarePrompt(prompt)
	if not (prompt and prompt.Parent) then return false end
	local path=lowerText(prompt:GetFullName()); local patrol=workspace:FindFirstChild("Patrol")
	if patrol and prompt:IsDescendantOf(patrol) then return true end
	local pText=lowerText(prompt.ActionText.." "..prompt.ObjectText)
	if containsAny(pText,jumpscareWords) then return true end
	return isInActiveTrolley(prompt) and containsAny(path,jumpscarePaths)
end
local function moveToNearPrompt(prompt,part)
	local pPos=getPromptPosition(prompt,part); if not pPos then return false end
	local pPath=lowerText(getFullName(prompt)); local standCF=getPromptStandCFrame(prompt)
	if standCF then return moveToPosition(standCF.Position,State.WalkTimeout,2.5) end
	local char,hum,root=getCharacter(); if not (char and hum and root) then return false end
	local lookDir=Vector3.new(part.CFrame.LookVector.X,0,part.CFrame.LookVector.Z); if lookDir.Magnitude<0.05 then lookDir=Vector3.new(0,0,1) end
	local isStorage=containsAny(pPath,{"workspace.ruangpenyimpanan.urn.proximityprompt","workspace.ruangpenyimpanan.sabun.sabun.proximityprompt"})
	local isCremUrn=pPath=="workspace.ruangkremasi.urn.proximityprompt"
	if isStorage then return moveToPosition(storageStandPosition,State.WalkTimeout,2.5) end
	local fwd=2.5; if isCremUrn then fwd=4 end
	local target=pPos+lookDir.Unit*fwd
	if pPath=="workspace.story.activetrolley.part.proximityprompt" then target=pPos-lookDir.Unit*2.5 end
	local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances={char,part}; rp.IgnoreWater=true
	local gh=workspace:Raycast(Vector3.new(target.X,pPos.Y+5,target.Z),Vector3.new(0,-15,0),rp)
	if gh and gh.Instance.CanCollide and gh.Normal.Y>0.5 then target=Vector3.new(target.X,gh.Position.Y+hum.HipHeight+root.Size.Y*0.5,target.Z) end
	if moveToPosition(target,State.WalkTimeout,3) then
		local _,_,r2=getCharacter()
		if r2 and (r2.Position-pPos).Magnitude<=prompt.MaxActivationDistance+1 then return true end
	end
	local taskText=lowerText(getTaskText())
	if containsAny(taskText,{"place","taruh","pasang","letakkan"}) then
		for _,ang in ipairs({0,90,-90,180,45,-45,135,-135}) do
			if State.Unloaded then return false end
			local rad=math.rad(ang); local od=Vector3.new(math.cos(rad),0,math.sin(rad)); local alt=pPos+od*4
			local gh2=workspace:Raycast(Vector3.new(alt.X,pPos.Y+5,alt.Z),Vector3.new(0,-15,0),rp)
			if gh2 and gh2.Instance.CanCollide and gh2.Normal.Y>0.5 then alt=Vector3.new(alt.X,gh2.Position.Y+hum.HipHeight+root.Size.Y*0.5,alt.Z) end
			if moveToPosition(alt,8,2.5) then
				local _,_,r3=getCharacter()
				if r3 and (r3.Position-pPos).Magnitude<=prompt.MaxActivationDistance+1 then return true end
			end
		end
	end
	return false
end
local function moveToBesidePrompt(prompt,part)
	local pPos=getPromptPosition(prompt,part); if not pPos then return false end
	return moveToPosition(Vector3.new(pPos.X+3,pPos.Y,pPos.Z),State.WalkTimeout,3)
end
local function moveForTask(taskText,prompt,part)
	local pPath=prompt and prompt.Parent and lowerText(prompt:GetFullName()) or ""
	local isR101=containsAny(taskText,{"room 101","rooms 101"}) and string.find(pPath,"workspace.ruangpasien.101.trolli.proximityprompt",1,true)~=nil
	if not isR101 then return moveToNearPrompt(prompt,part) end
	return moveToPosition(room101StandCFrame.Position,State.WalkTimeout,3)
end
local function getTimingProfile(prompt)
	local pText=prompt and lowerText(prompt.ActionText.." "..prompt.ObjectText) or ""
	local pPath=prompt and prompt.Parent and lowerText(prompt:GetFullName()) or ""
	local isTrolley=containsAny(pPath,{"workspace.story.activetrolley"}) and containsAny(pText,{"push","grab","hold","release","move body"})
	if containsAny(pPath,jumpscarePaths) or containsAny(pText,jumpscareWords) then return jumpscareTiming end
	if isTrolley or containsAny(pText,{"place stretcher","place trolley","move stretcher"}) then return stretcherTiming end
	return defaultTiming
end
local function findTrolleyPrompt(words,inc)
	local s=workspace:FindFirstChild("Story"); local at=s and s:FindFirstChild("ActiveTrolley")
	local part=at and at:FindFirstChild("Part"); local pp=part and part:FindFirstChildOfClass("ProximityPrompt")
	if pp and (inc or pp.Enabled) and containsAny(pp.ActionText.." "..pp.ObjectText,words) then return pp end
	if at then for _,d in ipairs(at:GetDescendants()) do
		if d:IsA("ProximityPrompt") and (inc or d.Enabled) and containsAny(d.ActionText.." "..d.ObjectText,words) then return d end
	end end
	return nil
end
local function detectTrolleyCarryState()
	if findTrolleyPrompt({"release"},true) then State.TrolleyCarryState=true; return true end
	if findTrolleyPrompt({"push","grab","hold"},true) then State.TrolleyCarryState=false; return false end
	if State.TrolleyCarryState~=nil then return State.TrolleyCarryState end
	return false
end
local function isCarryingTrolley() return detectTrolleyCarryState()==true end
local function getTaskUi() return playerGui and playerGui:FindFirstChild("TaskUi") end
local function getMinigamesGui() return playerGui and playerGui:FindFirstChild("Minigames") end
local function getTaskText()
	local tu=getTaskUi(); local tf=tu and tu:FindFirstChild("Task")
	if not tf then return "" end
	local tl=tf:FindFirstChild("Task")
	if tl and tl:IsA("TextLabel") and tl.Text~="" and tl.Text~="Task" then return tl.Text:gsub("%s+"," "):match("^%s*(.-)%s*$") or "" end
	local ol=tf:FindFirstChild("ObjectiveLabel")
	if ol and ol:IsA("TextLabel") and ol.Text~="" and ol.Text~="Task" then return ol.Text:gsub("%s+"," "):match("^%s*(.-)%s*$") or "" end
	return ""
end
local function isShiftCompleted() return containsAny(getTaskText(),{"shift completed"}) end
local function isReturnStretcherTask(t) return containsAny(t,{"put stretcher to the lift","return the stretcher","return stretcher"}) end
local function isDestinationTask(t) t=lowerText(t); if containsAny(t,{"pick up","take stretcher","take the stretcher"}) then return false end; return string.find(t,"go to ",1,true)~=nil or string.find(t,"go back to ",1,true)~=nil or isReturnStretcherTask(t) end
local function isPromptHandled(prompt,taskText) local h=State.HandledEventPrompts[prompt]; return h==true or h~=nil and h==lowerText(taskText) end
local function promptRuleMatch(prompt,taskText,rule)
	local pPath=lowerText(prompt:GetFullName())
	if containsAny(pPath,rule.paths) then return true end
	if containsAny(taskText,{"place","taruh","pasang","letakkan"}) then
		local pAct=lowerText(prompt.ActionText.." "..prompt.ObjectText)
		if containsAny(pAct,{"place","taruh","pasang","letakkan"}) then
			if containsAny(taskText,{"shroud","kafan","sheet","kain"}) and containsAny(pAct,{"shroud","kafan","sheet","kain"}) then return true end
			if containsAny(taskText,{"urn"}) and containsAny(pAct,{"urn"}) then return true end
			if containsAny(taskText,{"soap","sabun"}) and containsAny(pAct,{"soap","sabun"}) then return true end
		end
	end
	return false
end
local function promptMatchesTask(prompt,taskText,skipCarry)
	if not (prompt and prompt.Parent) then return false end
	local pPath=lowerText(prompt:GetFullName()); taskText=lowerText(taskText)
	if taskText=="" or containsAny(pPath,blockedPromptPaths) then return false end
	if isDestinationTask(taskText) and not containsAny(taskText,{"make a call","lobby"}) then
		local at=lowerText(prompt.ActionText.." "..prompt.ObjectText)
		if not containsAny(at,{"place stretcher","place trolley"}) then return false end
		if not skipCarry and not isCarryingTrolley() then return false end
		local rn=taskText:match("go to rooms?%s+(%d+)")
		if rn then return string.find(pPath,"workspace.ruangpasien."..rn..".trolli.proximityprompt",1,true)~=nil end
		for _,r in ipairs(destinationRules) do if containsAny(taskText,r.words) then return containsAny(pPath,r.paths) end end
		for _,r in ipairs(areaRules) do if containsAny(taskText,r.words) and containsAny(pPath,r.paths) then return true end end
		return false
	end
	local pText=lowerText(prompt.ActionText.." "..prompt.ObjectText)
	if containsAny(taskText,{"move body","move the body","place body","place the body"}) then
		return containsAny(pText,{"move body","move the body","move body to the strecther","move body to the stretcher"})
	end
	for _,r in ipairs(taskPromptRules) do if containsAny(taskText,r.words) then return promptRuleMatch(prompt,taskText,r) end end
	for _,r in ipairs(areaRules) do if containsAny(taskText,r.words) and containsAny(pPath,r.paths) then return true end end
	return false
end
local function isAllowedPrompt(prompt)
	local path=lowerText(prompt:GetFullName())
	if containsAny(path,blockedPromptPaths) then return false end
	for _,ap in ipairs(allowedPromptPaths) do if string.find(path,ap,1,true) then return true end end
	return false
end
local function triggerPrompt(prompt,useHold,skipFacing)
	local _,hum,root=getCharacter()
	local pPart=getPromptPart(prompt); local pPos=getPromptPosition(prompt,pPart)
	local timing=getTimingProfile(prompt); local pPath=lowerText(getFullName(prompt))
	local isCremUrn=useHold and pPath=="workspace.ruangkremasi.urn.proximityprompt"
	if State.PromptBusy or not (hum and root and pPart and pPos and prompt.Enabled) then return false end
	if math.max(prompt.MaxActivationDistance+1,4)<(root.Position-pPos).Magnitude then return false end
	State.PromptBusy=true
	local autoRot,anch=hum.AutoRotate,root.Anchored
	State.ActivePrompt=prompt; State.ActivePromptKey=nil
	State.PromptHoldHumanoid=hum; State.PromptHoldRoot=root
	State.PromptOriginalAutoRotate=autoRot; State.PromptOriginalAnchored=anch
	hum.AutoRotate=false; hum:MoveTo(root.Position)
	if prompt.HoldDuration>0 then pcall(function()
		root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero; root.Anchored=true
	end) end
	local lookT=Vector3.new(pPos.X,root.Position.Y,pPos.Z)
	if not skipFacing and (lookT-root.Position).Magnitude>0.05 then
		pcall(function() TweenService:Create(root,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=CFrame.lookAt(root.Position,lookT)}):Play() end)
	end
	RunService.RenderStepped:Wait()
	local triggered=false; local conn
	pcall(function() conn=prompt.Triggered:Connect(function(p) if not p or p==localPlayer then triggered=true end end) end)
	local function wt(s) local dl=os.clock()+s; while not triggered and State.AutoFarm and State.ActivePrompt==prompt and prompt.Parent and os.clock()<dl do RunService.Heartbeat:Wait() end end
	local function wa(s) local dl=os.clock()+s; while State.AutoFarm and State.ActivePrompt==prompt and prompt.Parent and os.clock()<dl do RunService.Heartbeat:Wait() end return State.AutoFarm and State.ActivePrompt==prompt and prompt.Parent~=nil end
	if type(fireproximityprompt)=="function" then
		pcall(function() prompt.HoldDuration=0 end)
		pcall(fireproximityprompt,prompt,0); pcall(fireproximityprompt,prompt); wt(timing.InstantWait)
	end
	if not triggered then
		if isCremUrn then pcall(function()
			prompt:InputHoldBegin()
			if wa(math.max(prompt.HoldDuration,0)+timing.HoldPadding) then prompt:InputHoldEnd(); wt(timing.HeldWait); return end
			prompt:InputHoldEnd()
		end) elseif prompt.KeyboardKeyCode~=Enum.KeyCode.Unknown then
			State.ActivePromptKey=prompt.KeyboardKeyCode
			pcall(function() VirtualInputManager:SendKeyEvent(true,prompt.KeyboardKeyCode,false,game) end)
			local sa=wa(math.max(prompt.HoldDuration,0)+(useHold and timing.HoldPadding or timing.KeyPadding))
			pcall(function() VirtualInputManager:SendKeyEvent(false,prompt.KeyboardKeyCode,false,game) end)
			State.ActivePromptKey=nil
			if sa then wt(useHold and timing.HeldWait or timing.FallbackWait) end
		end
		if not triggered then pcall(function()
			prompt:InputHoldBegin()
			if wa(math.max(prompt.HoldDuration,0)+timing.InputPadding) then prompt:InputHoldEnd(); wt(timing.FallbackWait); return end
			prompt:InputHoldEnd()
		end) end
		if not triggered and type(fireproximityprompt)=="function" then pcall(fireproximityprompt,prompt); wt(timing.FallbackWait) end
	end
	local cancelled=not State.AutoFarm or State.ActivePrompt~=prompt
	if conn then pcall(function() conn:Disconnect() end) end
	releasePromptHold()
	if cancelled then return false end
	State.Cooldowns[prompt]=os.clock()+(triggered and timing.SuccessCooldown or timing.FailureCooldown)
	State.ForcePromptReposition[prompt]=true
	return triggered
end
local function scorePrompt(prompt,taskText,root)
	if prompt.Parent and prompt.Enabled and not prompt:IsDescendantOf(localPlayer.Character or game) then
		if isPromptHandled(prompt,taskText) then return nil end
		local pPart=getPromptPart(prompt); if not pPart then return nil end
		local pPath=lowerText(prompt:GetFullName())
		local score=100-(root.Position-pPart.Position).Magnitude*0.12
		for _,r in ipairs(taskPromptRules) do
			if containsAny(taskText,r.words) then
				if not promptRuleMatch(prompt,taskText,r) then return nil end
				score+=10000; break
			end
		end
		if isDestinationTask(taskText) and not containsAny(taskText,{"make a call","lobby"}) then return nil end
		local isNew=State.InitialPrompts[prompt]==false
		if isNew and State.UrgentEventPrompt~=prompt and not isJumpscarePrompt(prompt) and not promptMatchesTask(prompt,taskText) then return nil end
		if State.UrgentEventPrompt==prompt or isJumpscarePrompt(prompt) then score+=100000
		elseif not isAllowedPrompt(prompt) then return nil end
		for _,r in ipairs(areaRules) do if containsAny(taskText,r.words) and containsAny(pPath,r.paths) then score+=4000 end end
		if containsAny(prompt.ActionText.." "..prompt.ObjectText,jumpscareWords) then score+=20000 end
		if containsAny(taskText,{"room","slot","freezer","kulkas","patient","pasien"}) then
			for d in taskText:gmatch("%d+") do if string.find(pPath,"."..d..".",1,true) then score+=7000 end end
		end
		if State.Cooldowns[prompt] and os.clock()<State.Cooldowns[prompt] then score-=15000 end
		return score,pPart
	end
	return nil
end
local function pickBestPrompt()
	local _,_,root=getCharacter(); if not root then return nil end
	local taskText=lowerText(getTaskText()); local bp,bpart,bs
	for i=#State.Prompts,1,-1 do
		local p=State.Prompts[i]
		if not p.Parent then State.PromptKnown[p]=nil; table.remove(State.Prompts,i)
		else
			local s,part=scorePrompt(p,taskText,root)
			if s and (not bs or bs<s) then bp=p; bpart=part; bs=s end
		end
	end
	return bp,bpart
end
local function registerPrompt(prompt,isInit)
	if not prompt:IsA("ProximityPrompt") or State.PromptKnown[prompt] then return end
	State.PromptKnown[prompt]=true; State.InitialPrompts[prompt]=isInit==true
	table.insert(State.Prompts,prompt)
end
local function handleStandardPrompt()
	local taskText=lowerText(getTaskText())
	if isDestinationTask(taskText) and not containsAny(taskText,{"make a call","lobby"}) then return false end
	local prompt,part=pickBestPrompt(); if not (prompt and part) then return false end
	local _,_,root=getCharacter(); local pPos=getPromptPosition(prompt,part)
	local inRange=root and pPos and (root.Position-pPos).Magnitude<=prompt.MaxActivationDistance
	local needsRepo=State.ForcePromptReposition[prompt]==true
	local standCF=getPromptStandCFrame(prompt)
	if inRange and not needsRepo and not standCF then triggerPrompt(prompt)
	else
		if moveToNearPrompt(prompt,part) then
			local _,_,r2=getCharacter()
			if r2 and pPos and (r2.Position-pPos).Magnitude<=prompt.MaxActivationDistance+1 then triggerPrompt(prompt)
			else State.Cooldowns[prompt]=os.clock()+0.8 end
		else State.Cooldowns[prompt]=os.clock()+0.8 end
	end
	return true
end
local function solveWireMinigame(mg)
	local colors={"Red","Blue","Green","Yellow"}
	local function pair(c) local l=mg:FindFirstChild("Left"); local r=mg:FindFirstChild("Right"); return l and l:FindFirstChild(c), r and r:FindFirstChild(c) end
	local function isConn(c) local lw,rw=pair(c); return lw and rw and lw:IsA("GuiButton") and rw:IsA("GuiButton") and not lw.Active and not rw.Active end
	for _,c in ipairs(colors) do
		if not (State.AutoFarm and State.AutoMinigame and isGuiVisible(mg)) then break end
		if not isConn(c) then
			local lw,rw=pair(c)
			if lw and rw and lw.Active and rw.Active then pressButton(lw); task.wait(0.08); pressButton(rw); task.wait(0.15) end
		end
	end
	task.wait(0.4)
	if isGuiVisible(mg) then
		local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local mh=gp and gp:FindFirstChild("MinigamesHandler")
		if mh and mh:IsA("RemoteEvent") then mg.Visible=false; pcall(function() mh:FireServer("Wire","Finished") end) end
	end
	return not isGuiVisible(mg)
end
local function solveCheckMinigame(mg)
	for _=1,30 do
		if not (State.AutoFarm and State.AutoMinigame and isGuiVisible(mg)) then break end
		local btn; local ch=mg:FindFirstChild("Check")
		if ch then for _,c in ipairs(ch:GetChildren()) do if c:IsA("ImageButton") and c.Visible then btn=c; break end end end
		if btn then pressButton(btn); task.wait(0.18) else task.wait(0.05) end
	end
end
local function solveTimingMinigame(mg)
	for _=1,800 do
		if not (State.AutoFarm and State.AutoMinigame and isGuiVisible(mg)) then break end
		local bar=mg:FindFirstChild("Bar"); local ind=bar and bar:FindFirstChild("Indicator")
		local tz=bar and bar:FindFirstChild("TargetZone"); local mod=mg:FindFirstChild("Modal")
		if not (ind and tz and mod) then break end
		local ic=ind.AbsolutePosition.X+ind.AbsoluteSize.X/2
		local zl=tz.AbsolutePosition.X; local zr=tz.AbsolutePosition.X+tz.AbsoluteSize.X
		if zl<=ic and ic<=zr then clickGuiButton(mod); task.wait(0.1) else RunService.RenderStepped:Wait() end
	end
end
local function solveSlideMinigame(mg)
	local bar=mg:FindFirstChild("Bar"); if not bar then return end
	local by=bar.AbsolutePosition.Y+bar.AbsoluteSize.Y/2
	local bl=bar.AbsolutePosition.X+2; local br=bar.AbsolutePosition.X+bar.AbsoluteSize.X-2
	for s=0,45 do
		if not (State.AutoFarm and State.AutoMinigame and isGuiVisible(mg)) then break end
		VirtualInputManager:SendMouseMoveEvent(bl+(br-bl)*s/45,by,game); RunService.RenderStepped:Wait()
	end
end
local function solveScrubMinigame(mg)
	local lx=mg.AbsolutePosition.X+mg.AbsoluteSize.X*0.28
	local rx=mg.AbsolutePosition.X+mg.AbsoluteSize.X*0.72
	local ty=mg.AbsolutePosition.Y+mg.AbsoluteSize.Y*0.42
	local by=mg.AbsolutePosition.Y+mg.AbsoluteSize.Y*0.58
	VirtualInputManager:SendMouseButtonEvent(lx,ty,0,true,game,0)
	for s=1,240 do
		if not (State.AutoFarm and State.AutoMinigame and isGuiVisible(mg)) then break end
		VirtualInputManager:SendMouseMoveEvent(s%2==0 and lx or rx,s%4<2 and ty or by,game); RunService.RenderStepped:Wait()
	end
	VirtualInputManager:SendMouseButtonEvent(rx,by,0,false,game,0)
end
local function handleMinigame()
	if State.MinigameBusy or not State.AutoMinigame then return false end
	local mgGui=getMinigamesGui(); if not mgGui then return false end
	local solvers={
		Electrical={remote="Wire",solver=solveWireMinigame},
		Washing={remote="Washing",solver=solveScrubMinigame},
		Autopsy={remote="Autopsy",solver=solveCheckMinigame},
		Injection={remote="TimingGame",solver=solveTimingMinigame},
		Cutting={remote="Scalpel",solver=solveSlideMinigame},
		Dressing={remote="Dressing",solver=solveScrubMinigame}
	}
	local active,solver
	for name,info in pairs(solvers) do local c=mgGui:FindFirstChild(name); if c and isGuiVisible(c) then active=c; solver=info; break end end
	if not active then return false end
	State.MinigameBusy=true; cancelMovement()
	setStatus("Solving: "..active.Name,{Phase="minigame"})
	pcall(solver.solver,active); task.wait(0.2)
	if isGuiVisible(active) then
		local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local mh=gp and gp:FindFirstChild("MinigamesHandler")
		if mh and mh:IsA("RemoteEvent") then pcall(function() mh:FireServer(solver.remote,"Finished") end); active.Visible=false end
	end
	State.MinigameBusy=false; State.Stats.MinigamesSolved+=1; saveConfig(); return true
end
local function handlePhone()
	local taskText=lowerText(getTaskText())
	local phoneTask=containsAny(taskText,{"pick up the phone","pick up phone","answer the phone","answer phone","make a call","answering the call","return to lobby and make a call","call nurse"})
	local tu=getTaskUi(); local phone=tu and tu:FindFirstChild("Phone")
	local phoneVis=phone and isGuiVisible(phone)
	if not phoneTask and not phoneVis then return false end
	local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local ph=gp and gp:FindFirstChild("PhoneHandler")
	if ph and ph:IsA("RemoteEvent") then pcall(function() ph:FireServer("Accept") end) end
	local handled=false
	if phoneVis then local acc=phone:FindFirstChild("Accept"); if acc then clickGuiButton(acc); handled=true end end
	local lp=workspace:FindFirstChild("Lobby") and workspace.Lobby:FindFirstChild("FrontTable") and workspace.Lobby.FrontTable:FindFirstChild("Phone")
	local base=lp and lp:FindFirstChild("Base"); local prompt
	if base then
		if base:FindFirstChild("ProximityPrompt2") and base.ProximityPrompt2.Enabled then prompt=base.ProximityPrompt2
		elseif base:FindFirstChild("ProximityPrompt") and base.ProximityPrompt.Enabled then prompt=base.ProximityPrompt end
	end
	if not (prompt and prompt.Enabled) and lp then prompt=lp:FindFirstChildWhichIsA("ProximityPrompt",true) end
	if prompt and prompt.Enabled then
		local parent=prompt.Parent; local _,_,root=getCharacter(); local pPos=getPromptPosition(prompt,parent)
		if root and pPos and (root.Position-pPos).Magnitude<=prompt.MaxActivationDistance then pcall(fireproximityprompt,prompt,0); handled=true
		elseif moveToNearPrompt(prompt,parent) then pcall(fireproximityprompt,prompt,0); handled=true end
	end
	if handled then State.Stats.CallsHandled+=1; setStatus("Phone handled",{Phase="phone"}); return true end
	return false
end
local function handleChoices()
	local dialogUi=playerGui and playerGui:FindFirstChild("DialogUi")
	local item=dialogUi and dialogUi:FindFirstChild("Item")
	if item and isGuiVisible(item) then local close=item:FindFirstChild("Close"); if close and clickGuiButton(close) then task.wait(0.1) end end
	if os.clock()-State.LastPhoneAt<0.5 then return false end
	local tu=getTaskUi(); if not tu then return false end
	local phone=tu:FindFirstChild("Phone")
	if phone and isGuiVisible(phone) then
		local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local ph=gp and gp:FindFirstChild("PhoneHandler")
		if ph and ph:IsA("RemoteEvent") then pcall(function() ph:FireServer("Accept") end) end
		local acc=phone:FindFirstChild("Accept"); if acc then clickGuiButton(acc) end
		State.LastPhoneAt=os.clock(); cancelMovement(); State.Stats.CallsHandled+=1; setStatus("Accepted call",{Phase="ui"}); return true
	end
	local phone2=tu:FindFirstChild("Phone2")
	if phone2 and isGuiVisible(phone2) then
		local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local ph=gp and gp:FindFirstChild("PhoneHandler")
		if ph and ph:IsA("RemoteEvent") then pcall(function() ph:FireServer("Decline") end) end
		local dec=phone2:FindFirstChild("Decline"); if dec then clickGuiButton(dec) end
		State.LastPhoneAt=os.clock(); cancelMovement(); setStatus("Declined call",{Phase="ui"}); return true
	end
	local secret=tu:FindFirstChild("Secret")
	if secret then for _,c in ipairs(secret:GetChildren()) do
		local dec=c:FindFirstChild("Decline")
		if dec and isGuiVisible(c) and clickGuiButton(dec) then State.LastPhoneAt=os.clock(); cancelMovement(); setStatus("Declined invite",{Phase="ui"}); return true end
	end end
	return false
end
local function handleStretcherPickup()
	local taskText=lowerText(getTaskText())
	if not containsAny(taskText,{"pick up the stretcher","pick up stretcher","take the stretcher","take stretcher","take and put stretcher","put stretcher to the lift","return the stretcher","return stretcher"}) then return false end
	local troll=workspace:FindFirstChild("Story") and workspace.Story:FindFirstChild("ActiveTrolley")
	local part=troll and troll:FindFirstChild("Part"); local pp=part and part:FindFirstChildWhichIsA("ProximityPrompt")
	if not (pp and pp.Enabled) then pp=troll and troll:FindFirstChildWhichIsA("ProximityPrompt",true); part=pp and pp.Parent end
	if pp and pp.Enabled and part and pp.ActionText=="Push" then
		setStatus("Pushing trolley...",{Phase="stretcher"})
		local _,_,root=getCharacter(); local pPos=getPromptPosition(pp,part)
		local inR=root and pPos and (root.Position-pPos).Magnitude<=pp.MaxActivationDistance
		if inR or moveToNearPrompt(pp,part) then triggerPrompt(pp,true) end
		return true
	end
	return false
end
local function findDestinationPrompt(obj)
	if State.TransportDestinationObjective~=obj then State.TransportDestinationObjective=obj; State.TransportDestinationPrompt=nil end
	local tdp=State.TransportDestinationPrompt
	if tdp and tdp.Parent and promptMatchesTask(tdp,obj,true) then return tdp end
	State.TransportDestinationPrompt=nil; local fb
	for _,p in ipairs(State.Prompts) do
		if p.Parent and containsAny(p.ActionText.." "..p.ObjectText,{"place stretcher","place trolley"}) and promptMatchesTask(p,obj,true) then
			if p.Enabled then State.TransportDestinationPrompt=p; return p end
			fb=fb or p
		end
	end
	State.TransportDestinationPrompt=fb; return fb
end
local function handleStretcherTransport()
	local taskText=lowerText(getTaskText())
	local isLift=isReturnStretcherTask(taskText); local isDest=isDestinationTask(taskText)
	local isR101=containsAny(taskText,{"room 101","rooms 101"})
	if not isR101 then State.Room101AnchorObjective=nil end
	if not isLift then State.LiftTransportObjective=nil; State.LiftTransportPhase=nil; State.LiftExitCFrame=nil; State.LiftTransportConfirmUntil=0
	elseif State.LiftTransportObjective~=taskText then State.LiftTransportObjective=taskText; State.LiftTransportPhase=nil; State.LiftExitCFrame=nil; State.LiftTransportConfirmUntil=0 end
	if not isDest or containsAny(taskText,{"make a call","lobby"}) or State.UrgentEventPrompt then State.TransportDestinationObjective=nil; State.TransportDestinationPrompt=nil; return false end
	if State.TransportProgressObjective then
		if State.TransportProgressObjective~=taskText then State.TransportProgressObjective=nil; State.TransportProgressUntil=0
		elseif os.clock()<State.TransportProgressUntil then return true
		else State.TransportProgressObjective=nil; State.TransportProgressUntil=0 end
	end
	local destP=findDestinationPrompt(taskText); if not destP then return false end
	local isR101P=isR101 and string.find(lowerText(destP:GetFullName()),"workspace.ruangpasien.101.trolli.proximityprompt",1,true)~=nil
	local destPart=getPromptPart(destP)
	if isLift and not destPart then return true end
	local relP=findTrolleyPrompt({"release"},true); local pushP=findTrolleyPrompt({"push","grab","hold"},true)
	local carry=detectTrolleyCarryState()
	if isLift and State.LiftTransportPhase=="waiting_for_auto_drop" then
		local _,_,root=getCharacter()
		if carry==false or pushP then
			if root then
				local exitCF=State.LiftExitCFrame or root.CFrame*CFrame.new(0,0,26)
				moveToPosition(exitCF.Position,12,3); State.TrolleyCarryState=false
				State.LiftTransportPhase="exited_lift"; State.LiftTransportConfirmUntil=os.clock()+3
				setStatus("Exited lift...",{Phase="transport"})
			end
		elseif State.LiftTransportConfirmUntil>0 and os.clock()>=State.LiftTransportConfirmUntil then
			State.LiftTransportPhase=nil; State.LiftExitCFrame=nil; State.LiftTransportConfirmUntil=0; State.TrolleyCarryState=nil
		end
		return true
	end
	if isLift and State.LiftTransportPhase=="exited_lift" then
		if State.LiftTransportConfirmUntil>0 and os.clock()<State.LiftTransportConfirmUntil then return true end
		State.LiftTransportPhase=nil; State.LiftExitCFrame=nil; State.LiftTransportConfirmUntil=0
		State.TransportProgressObjective=nil; State.TransportProgressUntil=0; State.TrolleyCarryState=nil
	end
	if carry==false and pushP then
		if State.Cooldowns[pushP] and os.clock()<State.Cooldowns[pushP] then return true end
		local pushPart=getPromptPart(pushP); if not pushPart then return true end
		local isMorgue=containsAny(taskText,{"go to the morgue room","go to morgue room","go back to the embalming room","go back to embalming room"})
		local _,_,root=getCharacter(); local pushPos=getPromptPosition(pushP,pushPart)
		local inR=root and pushPos and (root.Position-pushPos).Magnitude<=pushP.MaxActivationDistance
		local reached=isMorgue and (moveToBesidePrompt(pushP,pushPart) or inR) or moveToNearPrompt(pushP,pushPart) or inR
		if reached and triggerPrompt(pushP,true) then task.wait(0.35); State.TrolleyCarryState=detectTrolleyCarryState()
		else State.Cooldowns[pushP]=os.clock()+0.4 end
		return true
	end
	if carry~=true then return true end
	if isLift then
		local _,_,root=getCharacter(); if not root then return true end
		if moveToPosition(liftExitCFrame.Position,15,3) then
			State.LiftExitCFrame=liftExitCFrame*CFrame.new(0,0,26)
			State.LiftTransportPhase="waiting_for_auto_drop"; State.LiftTransportConfirmUntil=os.clock()+3
			setStatus("At lift...",{Phase="transport"})
		end
		return true
	end
	local _,_,root=getCharacter(); if not (destPart and root) then return true end
	local destPos=getPromptPosition(destP,destPart)
	local inRange=destPos and (root.Position-destPos).Magnitude<=destP.MaxActivationDistance
	if isR101P and State.Room101AnchorObjective~=taskText then
		if moveForTask(taskText,destP,destPart) then State.Room101AnchorObjective=taskText end
		return true
	end
	if destP.Enabled then
		if inRange then State.EventBusy=true; triggerPrompt(destP,true,isR101P); State.EventBusy=false
		else moveForTask(taskText,destP,destPart) end
		return true
	end
	if inRange then
		if relP then
			if State.Cooldowns[relP] and os.clock()<State.Cooldowns[relP] then return true end
			State.EventBusy=true; setStatus("Releasing: "..taskText,{Phase="transport"})
			if triggerPrompt(relP,true,isR101P) then task.wait(0.3); State.TrolleyCarryState=false end
			State.EventBusy=false; return true
		end
		task.wait(0.25); return true
	end
	moveForTask(taskText,destP,destPart); return true
end
local function pickStainTarget(root)
	local stain=workspace:FindFirstChild("Stain"); if not stain then return nil,0 end
	local target,bd,count; count=0
	for _,sp in ipairs(stain:GetChildren()) do
		if sp:IsA("BasePart") and sp.Parent then
			count+=1
			if not target then local d=(root.Position-sp.Position).Magnitude; if not bd or d<bd then target=sp; bd=d end end
		end
	end
	return target,count
end
local function findGroundPosition(part,char,hum,root)
	local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances={char,part}; rp.IgnoreWater=true; rp.RespectCanCollide=true
	local rh=part.Size.Y*0.5+4
	local gh=workspace:Raycast(Vector3.new(part.Position.X,part.Position.Y+rh,part.Position.Z),Vector3.new(0,-(rh+6.5),0),rp)
	if not (gh and gh.Instance.CanCollide) or gh.Normal.Y<=0.5 then return nil end
	return Vector3.new(part.Position.X,gh.Position.Y+hum.HipHeight+root.Size.Y*0.5,part.Position.Z)
end
local function handleCleaning()
	local taskText=lowerText(getTaskText())
	if not containsAny(taskText,{"clean the area","clean area","bersihkan area"}) then return false end
	local char,hum,root=getCharacter(); if not (char and hum and root) then return true end
	local bp=localPlayer:FindFirstChildOfClass("Backpack"); local broom=char:FindFirstChild("Broom") or bp and bp:FindFirstChild("Broom")
	if not broom then
		local mopR=workspace:FindFirstChild("Lobby") and workspace.Lobby:FindFirstChild("Mop")
		local pp=mopR and mopR:FindFirstChildWhichIsA("ProximityPrompt",true)
		if pp and pp.Enabled then
			local ppPart=getPromptPart(pp)
			if ppPart and (moveToNearPrompt(pp,ppPart) or (root.Position-ppPart.Position).Magnitude<=pp.MaxActivationDistance) then triggerPrompt(pp,false); task.wait(0.2) end
		end
		broom=char:FindFirstChild("Broom") or bp and bp:FindFirstChild("Broom")
		if not (broom and broom:IsA("Tool")) then return false end
	end
	if broom.Parent~=char then pcall(function() hum:EquipTool(broom) end); task.wait(0.12) end
	local stainT,remaining=pickStainTarget(root); if not stainT then task.wait(0.2); return true end
	setStatus(string.format("Cleaning (%d left)",remaining),{Phase="cleaning"})
	local gp=findGroundPosition(stainT,char,hum,root)
	if gp then
		local look=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
		if look.Magnitude<0.05 then look=Vector3.new(0,0,-1) end
		pcall(function() root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero; root.CFrame=CFrame.lookAt(gp,gp+look.Unit) end)
	end
	local dl=os.clock()+6
	while State.AutoFarm and stainT.Parent and containsAny(getTaskText(),{"clean the area","clean area"}) and os.clock()<dl do pcall(function() broom:Activate() end); task.wait(0.08) end
	return true
end
local function findJumpscarePrompt()
	local story=workspace:FindFirstChild("Story"); local at=story and story:FindFirstChild("ActiveTrolley")
	local js=at and at:FindFirstChild("Jumpscare"); local patrol=workspace:FindFirstChild("Patrol")
	local roots={}; if js then table.insert(roots,js) end; if patrol then table.insert(roots,patrol) end
	for _,r in ipairs(roots) do for _,d in ipairs(r:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and d.Parent and not State.HandledEventPrompts[d] then registerPrompt(d,false); return d end
	end end
	for _,p in ipairs(State.Prompts) do if p.Parent and p.Enabled and not State.HandledEventPrompts[p] and isJumpscarePrompt(p) then return p end end
	return nil
end
local function queueUrgentPrompt(prompt)
	local isJs=isJumpscarePrompt(prompt); local taskText=getTaskText()
	if not (State.AutoFarm and prompt and prompt.Parent and prompt.Enabled and not isPromptHandled(prompt,taskText) and (isJs or promptMatchesTask(prompt,taskText))) then return false end
	if State.UrgentEventPrompt==prompt then return true end
	if State.UrgentEventPrompt and (State.UrgentPromptIsJumpscare or not isJs) then return false end
	State.Cooldowns[prompt]=0; State.UrgentEventPrompt=prompt; State.UrgentRetryAt=0
	State.UrgentPromptBaseline=lowerText(taskText); State.UrgentPromptTriggered=false
	State.UrgentConfirmUntil=0; State.UrgentPromptIsJumpscare=isJs
	cancelMovement(); setStatus(isJs and "JUMPSCARE!" or "Task queued",{Phase=isJs and "event" or "prompt"})
	return true
end
local function clearUrgentPrompt(prompt,markHandled)
	if prompt and State.UrgentEventPrompt~=prompt then return end
	local ue=prompt or State.UrgentEventPrompt
	if markHandled and ue then State.HandledEventPrompts[ue]=true end
	State.UrgentEventPrompt=nil; State.UrgentRetryAt=0; State.UrgentPromptBaseline=nil
	State.UrgentPromptTriggered=false; State.UrgentConfirmUntil=0; State.UrgentPromptIsJumpscare=false
end
local function handleUrgentPrompt()
	local ue=State.UrgentEventPrompt; if not ue then return false end
	local taskText=lowerText(getTaskText()); local isJs=isJumpscarePrompt(ue); local timing=getTimingProfile(ue)
	if not isJs and isReturnStretcherTask(taskText) then clearUrgentPrompt(ue,false); return false end
	State.UrgentPromptIsJumpscare=isJs
	if State.UrgentPromptTriggered then
		if not ue.Enabled then if isJs then State.Stats.JumpscaresCleared+=1 end; clearUrgentPrompt(ue,true); return false end
		if os.clock()<State.UrgentConfirmUntil then return true end
		State.UrgentPromptTriggered=false; State.UrgentConfirmUntil=0; State.UrgentRetryAt=os.clock()+timing.RetryDelay
	end
	if not (ue.Parent and ue.Enabled) or (not isJs and not promptMatchesTask(ue,taskText)) then clearUrgentPrompt(ue,false); return false end
	if State.EventBusy or os.clock()<State.UrgentRetryAt then return true end
	local pp=getPromptPart(ue); if not pp then State.UrgentRetryAt=os.clock()+0.2; return true end
	State.EventBusy=true; cancelMovement()
	local triggered=false
	if moveToNearPrompt(ue,pp) then
		triggered=triggerPrompt(ue,not isJs)
		if State.UrgentEventPrompt==ue and triggered then State.UrgentPromptTriggered=true; State.UrgentConfirmUntil=os.clock()+timing.ConfirmDelay end
	end
	if State.UrgentEventPrompt==ue then State.UrgentRetryAt=os.clock()+timing.RetryDelay end
	State.EventBusy=false; return true
end
local function checkGroupMembership() pcall(function() State.Stats.InGroup=localPlayer:IsInGroup(33970134) end) end
local function startSoloShift()
	if not State.AutoStartSolo then return false end
	if os.clock()-State.LastLobbyCreateAt<5 then return false end
	State.LastLobbyCreateAt=os.clock(); setStatus("Starting Solo Shift...",{Phase="lobby"}); queueReexecOnTeleport()
	local server=ReplicatedStorage:FindFirstChild("Server"); local cs=server and server:FindFirstChild("CreateServer")
	if cs and cs:IsA("RemoteEvent") then cs:FireServer({MaxPlayers=1,FriendsOnly=false,GameMode="Classic"},true); return true end
	local start=workspace:FindFirstChild("Start"); local _,_,root=getCharacter()
	if start and root then root.CFrame=CFrame.new(start.Position+Vector3.new(0,3,0)) end
	return true
end
local handlers={
	{Name="urgent",Delay=0.04,Run=handleUrgentPrompt},
	{Name="minigame",Delay=0.15,Run=handleMinigame},
	{Name="choices",Delay=0.15,Run=handleChoices},
	{Name="phone",Delay=0.15,Run=handlePhone},
	{Name="stretcher_pickup",Delay=0.15,Run=handleStretcherPickup},
	{Name="stretcher_transport",Delay=0.12,Run=handleStretcherTransport},
	{Name="cleaning",Delay=0.12,Run=handleCleaning},
	{Name="standard",Delay=0.15,Run=handleStandardPrompt}
}
local function workerStep()
	State.LastHeartbeatAt=os.clock()
	if State.IsLobby then checkGroupMembership(); if State.AutoStartSolo and startSoloShift() then return 3 end; return 1 end
	if not State.AutoFarm and not State.AutoMinigame then State.ActiveHandler="idle"; return 0.5 end
	if State.AutoFarm and isShiftCompleted() then
		if not State.ShiftCompletedLatched then State.ShiftCompletedLatched=true; State.Stats.ShiftsCompleted+=1; saveConfig() end
		setStatus("Shift done -> lobby",{Phase="rejoin"}); queueReexecOnTeleport(); task.wait(1)
		pcall(function() TeleportService:Teleport(122093998639862,localPlayer) end); return 2.5
	end
	if State.AutoFarm then local js=findJumpscarePrompt(); if js then queueUrgentPrompt(js) end end
	for _,h in ipairs(handlers) do State.ActiveHandler=h.Name; if h.Run() then return h.Delay end end
	State.ActiveHandler="idle"; return 0.25
end
local function startWorker()
	State.WorkerCoroutine=task.spawn(function() while not State.Unloaded do local ok,wt=pcall(workerStep); task.wait(not ok and 0.5 or wt or 0.25) end end)
end
local function watchdog()
	while not State.Unloaded do
		task.wait(4); local now=os.clock(); pcall(function() GuiService:ClearError() end)
		local dead=State.WorkerCoroutine==nil or coroutine.status(State.WorkerCoroutine)=="dead"
		local stalled=State.AutoFarm and now-State.LastHeartbeatAt>25
		if dead or stalled then setStatus("Watchdog revive",{Phase="recovery"}); cancelMovement(); releasePromptHold(); State.LastHeartbeatAt=now; startWorker() end
	end
end

local MorgueAPI={}
MorgueAPI.State=State
function MorgueAPI.SetAutoFarm(v) State.AutoFarm=v and true or false; if not State.AutoFarm then cancelMovement(); releasePromptHold() end; setStatus(State.AutoFarm and "Auto farm ON" or "Auto farm OFF",{Phase="lifecycle"}); saveConfig(); return State.AutoFarm end
function MorgueAPI.SetAutoStartSolo(v) State.AutoStartSolo=v and true or false; setStatus(v and "Solo ON" or "Solo OFF",{Phase="lifecycle"}); saveConfig(); return State.AutoStartSolo end
function MorgueAPI.SetAutoMinigame(v) State.AutoMinigame=v and true or false; setStatus(v and "Minigame ON" or "Minigame OFF",{Phase="lifecycle"}); saveConfig(); return State.AutoMinigame end
function MorgueAPI.SetNoclip(v)
	State.Noclip=v and true or false
	local char=localPlayer.Character
	if State.Noclip then if char then applyNoclipOnce(char) end; setStatus("Noclip ON",{Phase="lifecycle"})
	else if char then for _,d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.CanCollide=true end end end; setStatus("Noclip OFF",{Phase="lifecycle"}) end
	saveConfig(); return State.Noclip
end
function MorgueAPI.SetTweenMode(v) State.TweenMode=v and true or false; setStatus(State.TweenMode and "Tween mode ON" or "Walk mode",{Phase="lifecycle"}); saveConfig(); return State.TweenMode end
function MorgueAPI.IsAutoFarm() return State.AutoFarm end
function MorgueAPI.IsAutoStartSolo() return State.AutoStartSolo end
function MorgueAPI.IsAutoMinigame() return State.AutoMinigame end
function MorgueAPI.IsNoclip() return State.Noclip end
function MorgueAPI.IsTweenMode() return State.TweenMode end
function MorgueAPI.GetStats() return {ShiftsCompleted=State.Stats.ShiftsCompleted or 0,MinigamesSolved=State.Stats.MinigamesSolved or 0,JumpscaresCleared=State.Stats.JumpscaresCleared or 0,CallsHandled=State.Stats.CallsHandled or 0} end
function MorgueAPI.GetStatus() return State.Status.Message or "Idle",State.Status.Phase or "idle" end
function MorgueAPI.ResetShiftLatched() State.ShiftCompletedLatched=false end
function MorgueAPI.Unload() if State.Unload then State.Unload() end end
getgenv().MorgueAPI = MorgueAPI

State.Unload=function()
	State.Unloaded=true; State.AutoFarm=false; State.AutoMinigame=false; State.AutoStartSolo=false; State.Noclip=false; State.TweenMode=false
	releasePromptHold(); cancelMovement()
	pcall(function() VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0) end)
	for _,c in ipairs(State.Connections) do pcall(function() c:Disconnect() end) end
	table.clear(State.Connections)
	if env.MorgueMini==State then env.MorgueMini=nil end
	if getgenv().MorgueAPI==MorgueAPI then getgenv().MorgueAPI=nil end
	print("[MorgueEngine] Unloaded.")
end

loadConfig(); saveConfig()
for _,d in ipairs(workspace:GetDescendants()) do if d:IsA("ProximityPrompt") then registerPrompt(d,true) end end
table.insert(State.Connections,workspace.DescendantAdded:Connect(function(inst) if inst:IsA("ProximityPrompt") then registerPrompt(inst,false); if State.AutoFarm then queueUrgentPrompt(inst) end end end))
table.insert(State.Connections,localPlayer.Idled:Connect(function() pcall(function() VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end) end))
local function onCharAdded(char)
	if not char then return end
	releasePromptHold(); cancelMovement(); State.TrolleyCarryState=nil
	local hum=char:WaitForChild("Humanoid",5)
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated,false); if hum.Sit then hum.Sit=false end
		if State.Noclip then applyNoclipOnce(char) end
		table.insert(State.Connections,hum.Died:Connect(function()
			releasePromptHold(); cancelMovement(); State.TrolleyCarryState=nil; task.wait(0.8)
			local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local rh=gp and gp:FindFirstChild("RespawnHandler")
			if rh and rh:IsA("RemoteEvent") then pcall(function() rh:FireServer() end) end
		end))
	end
end
if localPlayer.Character then onCharAdded(localPlayer.Character) end
table.insert(State.Connections,localPlayer.CharacterAdded:Connect(onCharAdded))
startNoclipLoop(); startWorker()
table.insert(State.Connections,task.spawn(watchdog))
setStatus("Engine loaded.",{Phase="lifecycle"})
print("[MorgueEngine] Loaded.")

