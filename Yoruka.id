coll:AddSection("Pumpkin")
coll:AddToggle("Auto Collect Pumpkin", false, function(v) OC.AutoCollectPumpkin=v end)
coll:AddDropdown("Pumpkin Method", {"walk","path"}, "walk", function(v) OC.PumpkinMethod=v end)
