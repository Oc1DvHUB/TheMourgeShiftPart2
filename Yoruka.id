local Themes = {
	Midnight = {Bg=Color3.fromRGB(20,22,30),Card=Color3.fromRGB(34,38,52),Side=Color3.fromRGB(26,30,44),Hover=Color3.fromRGB(52,58,80),Text=Color3.fromRGB(255,255,255),Sub=Color3.fromRGB(196,202,220),Off=Color3.fromRGB(90,92,104),Line=Color3.fromRGB(90,100,130),Accent=Color3.fromRGB(10,132,255)},
	Rose = {Bg=Color3.fromRGB(30,18,26),Card=Color3.fromRGB(50,30,42),Side=Color3.fromRGB(38,22,32),Hover=Color3.fromRGB(72,42,60),Text=Color3.fromRGB(255,255,255),Sub=Color3.fromRGB(232,192,212),Off=Color3.fromRGB(110,80,95),Line=Color3.fromRGB(140,90,115),Accent=Color3.fromRGB(255,105,150)},
	Emerald = {Bg=Color3.fromRGB(14,28,24),Card=Color3.fromRGB(24,48,42),Side=Color3.fromRGB(18,36,31),Hover=Color3.fromRGB(36,70,60),Text=Color3.fromRGB(255,255,255),Sub=Color3.fromRGB(182,222,206),Off=Color3.fromRGB(70,100,90),Line=Color3.fromRGB(70,130,110),Accent=Color3.fromRGB(52,211,153)},
	Gold = {Bg=Color3.fromRGB(28,24,16),Card=Color3.fromRGB(50,42,26),Side=Color3.fromRGB(36,30,18),Hover=Color3.fromRGB(72,60,34),Text=Color3.fromRGB(255,255,255),Sub=Color3.fromRGB(226,212,172),Off=Color3.fromRGB(110,98,70),Line=Color3.fromRGB(140,120,70),Accent=Color3.fromRGB(240,190,60)},
	Light = {Bg=Color3.fromRGB(240,244,252),Card=Color3.fromRGB(255,255,255),Side=Color3.fromRGB(226,232,244),Hover=Color3.fromRGB(232,238,250),Text=Color3.fromRGB(28,28,30),Sub=Color3.fromRGB(90,96,110),Off=Color3.fromRGB(200,204,214),Line=Color3.fromRGB(205,210,222),Accent=Color3.fromRGB(10,132,255)}
}
local Theme = {}
for k,v in pairs(Themes.Midnight) do Theme[k]=v end
local STATUS = {Green=Color3.fromRGB(48,209,88),Red=Color3.fromRGB(255,69,58),Yellow=Color3.fromRGB(255,214,10)}

local function hex(c) return string.format("%02X%02X%02X",math.floor(c.R*255+0.5),math.floor(c.G*255+0.5),math.floor(c.B*255+0.5)) end
local BRAND_BASE,BRAND_HUB = "Oc1Dv","HUB"
local function brandString() return string.format('<font color="#%s">%s</font><font color="#%s">%s</font>',hex(Theme.Text),BRAND_BASE,hex(Theme.Accent),BRAND_HUB) end

local bound,refreshers={},{}
local function bind(obj,prop,key) obj[prop]=Theme[key]; table.insert(bound,{obj,prop,key}) end
local function applyTheme()
	for i=#bound,1,-1 do
		local b=bound[i]
		if not b[1]:IsDescendantOf(game) then table.remove(bound,i)
		else TweenService:Create(b[1],TweenInfo.new(0.25),{[b[2]]=Theme[b[3]]}):Play() end
	end
	for _,f in ipairs(refreshers) do f() end
end
local function new(class,props,parent) local o=Instance.new(class); for k,v in pairs(props) do o[k]=v end; if parent then o.Parent=parent end; return o end
local function round(o,r) new("UICorner",{CornerRadius=UDim.new(0,r)},o) end
local function tween(o,t,p) TweenService:Create(o,TweenInfo.new(t,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p):Play() end
local function isPress(i) return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch end
local function drag(handle,target)
	local st={moved=false}; local dragging,start,startPos
	handle.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging,start,startPos,st.moved=true,i.Position,target.Position,false
			i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then dragging=false end end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			local d=i.Position-start; if d.Magnitude>6 then st.moved=true end
			target.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
		end
	end)
	return st
end
local function ripple(container,x,y)
	local ap=container.AbsolutePosition
	local r=new("Frame",{Size=UDim2.fromOffset(0,0),Position=UDim2.fromOffset(x-ap.X,y-ap.Y),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.8,ZIndex=5},container)
	round(r,100)
	local s=math.max(container.AbsoluteSize.X,container.AbsoluteSize.Y)*2
	tween(r,0.5,{Size=UDim2.fromOffset(s,s),BackgroundTransparency=1})
	task.delay(0.5,function() r:Destroy() end)
end
local function glowLayers(parent,pos,w,h,r,color,spread,base)
	local layers={}; base=base or {0.8,0.88,0.94}
	for n=3,1,-1 do
		local g=spread*n/3
		local f=new("Frame",{Position=UDim2.new(pos.X.Scale,pos.X.Offset-g,pos.Y.Scale,pos.Y.Offset-g),Size=UDim2.fromOffset(w+g*2,h+g*2),BackgroundColor3=color or Theme.Accent,BackgroundTransparency=base[n],BorderSizePixel=0},parent)
		round(f,r+g)
		if not color then bind(f,"BackgroundColor3","Accent") end
		layers[n]=f
	end
	return layers
end
local function iconBar(parent,cx,cy,w,h,rot,mode,corner)
	local f=new("Frame",{Size=UDim2.fromOffset(w,h),Position=UDim2.fromOffset(cx,cy),AnchorPoint=Vector2.new(0.5,0.5),BorderSizePixel=0,Rotation=rot or 0,BackgroundColor3=(mode=="cutout") and Theme.Side or Theme.Sub},parent)
	round(f,corner or math.min(w,h)/2)
	f:SetAttribute((mode=="cutout") and "IconCutout" or "IconInk",true)
	return f
end
local DrawnIcons = {
	home=function(box) iconBar(box,6,6,8.5,1.8,-45); iconBar(box,12,6,8.5,1.8,45); iconBar(box,3,13,1.8,8,0); iconBar(box,15,13,1.8,8,0); iconBar(box,9,16.5,12,1.8,0) end,
	gear=function(box)
		iconBar(box,9,9,13,13,0); iconBar(box,9,9,6,6,0,"cutout")
		for i=0,7 do local a=math.rad(i*45); iconBar(box,9+math.cos(a)*7.3,9+math.sin(a)*7.3,2.2,2.2,math.deg(a)) end
	end,
	eye=function(box) iconBar(box,9,9,16,9,0); iconBar(box,9,9,4,4,0,"cutout") end,
	user=function(box) iconBar(box,9,4.5,6,6,0); iconBar(box,9,13.5,12,6,0) end,
	box=function(box) iconBar(box,9,9,13,13,0); iconBar(box,9,9,9,9,0,"cutout",1.5) end,
	list=function(box) iconBar(box,9,3.5,13,1.8,0); iconBar(box,9,9,13,1.8,0); iconBar(box,9,14.5,13,1.8,0) end,
	shield=function(box) iconBar(box,9,7,12,8,0); iconBar(box,9,11,8.5,8.5,45) end,
	moon=function(box) iconBar(box,9,9,12,12,0); iconBar(box,12,8,9,9,0,"cutout") end
}
local function makeIcon(parent,icon,size)
	size=size or 18
	if type(icon)=="table" and icon.drawn and DrawnIcons[icon.drawn] then
		local holder=new("Frame",{Size=UDim2.fromOffset(size,size),Position=UDim2.new(0,11,0.5,-size/2),BackgroundTransparency=1},parent)
		local inner=new("Frame",{Size=UDim2.fromOffset(18,18),Position=UDim2.new(0.5,-9,0.5,-9),BackgroundTransparency=1},holder)
		new("UIScale",{Scale=size/18},inner)
		DrawnIcons[icon.drawn](inner)
		table.insert(refreshers,function()
			if not holder.Parent then return end
			for _,d in ipairs(inner:GetDescendants()) do if d:IsA("Frame") and d:GetAttribute("IconCutout") then d.BackgroundColor3=Theme.Side end end
		end)
		return holder
	end
	if type(icon)=="number" then icon="rbxassetid://"..icon end
	if type(icon)=="string" and icon:find("rbxassetid") then
		return new("ImageLabel",{Size=UDim2.fromOffset(size,size),Position=UDim2.new(0,11,0.5,-size/2),BackgroundTransparency=1,Image=icon,ImageColor3=Theme.Sub},parent)
	end
	return new("TextLabel",{Size=UDim2.fromOffset(size,size),Position=UDim2.new(0,11,0.5,-size/2),BackgroundTransparency=1,Text=icon or "*",TextSize=size-2,Font=Enum.Font.GothamBold,TextColor3=Theme.Sub,TextTransparency=0.4},parent)
end

function Lib:CreateWindow(title,opts)
	opts=opts or {}; local Window={}; local customTitle=title
	local toggleKey=opts.ToggleKey or Enum.KeyCode.RightShift
	local BG_IMAGE=opts.Background or ASSET_BG; local LOGO_IMAGE=opts.Logo or ASSET_LOGO
	local plr=Players.LocalPlayer
	local function topTitleText() if customTitle then return string.format('<font color="#%s">%s</font>',hex(Theme.Text),customTitle) end return brandString() end
	local gui=new("ScreenGui",{Name="YorukaUI",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},plr:WaitForChild("PlayerGui"))
	local blur=new("BlurEffect",{Name="YorukaBlur",Size=(opts.Blur==false) and 0 or 8},Lighting)
	gui.Destroying:Connect(function() blur:Destroy() end)
	local fpsNow=0
	do
		local frames,last=0,os.clock()
		local conn=RunService.RenderStepped:Connect(function() frames=frames+1 end)
		gui.Destroying:Connect(function() conn:Disconnect() end)
		task.spawn(function() while gui.Parent do task.wait(0.5); local now=os.clock(); fpsNow=math.floor(frames/math.max(now-last,0.001)+0.5); frames=0; last=now end end)
	end
	local function getPing()
		local ok,p=pcall(function() return StatsSvc.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		if ok and type(p)=="number" and p>0 then return p end
		local ok2,n=pcall(function() return plr:GetNetworkPing() end)
		if ok2 and type(n)=="number" then return n*1000 end
		return nil
	end
	function Window:GetFPS() return fpsNow end
	function Window:GetPing() return getPing() end
	local tip=new("TextLabel",{Visible=false,AutomaticSize=Enum.AutomaticSize.XY,Size=UDim2.fromOffset(0,0),BackgroundColor3=Color3.fromRGB(16,18,24),TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamMedium,TextSize=12,ZIndex=100,Text=""},gui)
	round(tip,8)
	new("UIPadding",{PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8),PaddingTop=UDim.new(0,5),PaddingBottom=UDim.new(0,5)},tip)
	local tipToken=0
	local function attachTip(obj,text,cond)
		obj.MouseEnter:Connect(function() tipToken=tipToken+1; local my=tipToken; task.delay(0.5,function() if my==tipToken and (not cond or cond()) then local m=UIS:GetMouseLocation(); tip.Text=text; tip.Position=UDim2.fromOffset(m.X+12,m.Y+12); tip.Visible=true end end) end)
		obj.MouseMoved:Connect(function() if tip.Visible then local m=UIS:GetMouseLocation(); tip.Position=UDim2.fromOffset(m.X+12,m.Y+12) end end)
		obj.MouseLeave:Connect(function() tipToken=tipToken+1; tip.Visible=false end)
	end
	local function ctl(frame,extra) local t=extra or {}; t.Frame=frame; t.SetTooltip=function(self,s) attachTip(frame,s); return self end; return t end
	local vp=workspace.CurrentCamera.ViewportSize
	local W,H=math.min(520,vp.X-30),math.min(340,vp.Y-70)
	local SIDE=(W<440) and 112 or 150
	local NORMAL=UDim2.fromOffset(W,H)
	local BIG=UDim2.fromOffset(math.min(660,vp.X-30),math.min(420,vp.Y-70))
	local curSize=NORMAL; local sideW=SIDE; local collapsed=false; local hudEnabled=true
	local openPalette,closePalette,setCollapsed,updateHud
	local main=new("Frame",{Size=NORMAL,Position=UDim2.new(0.5,-W/2,0.5,-H/2),ClipsDescendants=true},gui)
	bind(main,"BackgroundColor3","Bg"); round(main,16)
	local uiScale=new("UIScale",{Scale=1},main)
	local stroke=new("UIStroke",{Thickness=1,Transparency=0.55},main); bind(stroke,"Color","Line")
	local bgImg=new("ImageLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Image=BG_IMAGE,ScaleType=Enum.ScaleType.Crop,ZIndex=0},main); round(bgImg,16)
	local overlay=new("Frame",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=opts.Overlay or 0.88,ZIndex=1},main); bind(overlay,"BackgroundColor3","Bg"); round(overlay,16)
	local gloss=new("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=1},main); round(gloss,16)
	new("UIGradient",{Rotation=90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.82),NumberSequenceKeypoint.new(0.42,1),NumberSequenceKeypoint.new(1,1)})},gloss)
	local shine=new("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=1},main); round(shine,16)
	local shineGrad=new("UIGradient",{Rotation=25,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.42,1),NumberSequenceKeypoint.new(0.5,0.7),NumberSequenceKeypoint.new(0.58,1),NumberSequenceKeypoint.new(1,1)}),Offset=Vector2.new(-1,0)},shine)
	task.spawn(function()
		while gui.Parent do
			shineGrad.Offset=Vector2.new(-1,0)
			TweenService:Create(shineGrad,TweenInfo.new(1.8,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),{Offset=Vector2.new(1,0)}):Play()
			task.wait(1.8+4.2)
		end
	end)
	local top=new("Frame",{Size=UDim2.new(1,0,0,44),BackgroundTransparency=0.4},main); bind(top,"BackgroundColor3","Side"); round(top,16)
	local ttl=new("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,RichText=true,Text=topTitleText(),Font=Enum.Font.GothamBold,TextSize=15,TextStrokeTransparency=0.7},top)
	bind(ttl,"TextColor3","Text")
	table.insert(refreshers,function() if ttl.Parent then ttl.Text=topTitleText() end end)
	drag(top,main)
	local open=true
	local function setOpen(state)
		open=state; if updateHud then updateHud() end
		if state then
			main.Visible=true; tween(main,0.35,{Size=curSize}); if opts.Blur~=false then tween(blur,0.35,{Size=8}) end
		else
			tween(main,0.3,{Size=UDim2.fromOffset(curSize.X.Offset,0)}); tween(blur,0.3,{Size=0})
			task.delay(0.3,function() if not open then main.Visible=false end end)
		end
	end
	local hud=new("Frame",{Size=UDim2.fromOffset(132,30),Position=UDim2.new(0.5,-66,0,10),BackgroundTransparency=0.2,Visible=false},gui)
	bind(hud,"BackgroundColor3","Bg"); round(hud,15)
	local hudStroke=new("UIStroke",{Thickness=1,Transparency=0.5},hud); bind(hudStroke,"Color","Line")
	local hudDot=new("Frame",{Size=UDim2.fromOffset(8,8),Position=UDim2.new(0,12,0.5,-4),BackgroundColor3=STATUS.Green},hud); round(hudDot,4)
	local hudTxt=new("TextLabel",{Size=UDim2.new(1,-30,1,0),Position=UDim2.new(0,26,0,0),BackgroundTransparency=1,Text="-- fps | -- ms",Font=Enum.Font.GothamBold,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left},hud)
	bind(hudTxt,"TextColor3","Text")
	local hst=drag(hud,hud)
	hud.InputEnded:Connect(function(i) if isPress(i) and not hst.moved then setOpen(true) end end)
	updateHud=function() hud.Visible=hudEnabled and not open end
	task.spawn(function()
		while gui.Parent do
			if hud.Visible then
				local ping=getPing()
				if ping then hudTxt.Text=fpsNow.." fps | "..math.floor(ping).." ms" else hudTxt.Text=fpsNow.." fps | -- ms" end
				if fpsNow>=50 then hudDot.BackgroundColor3=STATUS.Green elseif fpsNow>=30 then hudDot.BackgroundColor3=STATUS.Yellow else hudDot.BackgroundColor3=STATUS.Red end
			end
			task.wait(0.5)
		end
	end)
	local function dot(color,x,cb) local b=new("TextButton",{Size=UDim2.fromOffset(14,14),Position=UDim2.new(0,x,0.5,-7),BackgroundColor3=color,Text="",AutoButtonColor=false},top); round(b,7); b.MouseButton1Click:Connect(cb) end
	dot(STATUS.Red,16,function() setOpen(false) end)
	dot(STATUS.Yellow,38,function() setOpen(false) end)
	dot(STATUS.Green,60,function() curSize=(curSize~=NORMAL) and NORMAL or BIG; tween(main,0.35,{Size=curSize}) end)
	local menuBtn=new("TextButton",{Size=UDim2.fromOffset(26,26),Position=UDim2.new(0,82,0.5,-13),BackgroundTransparency=1,Text="",AutoButtonColor=false},top)
	for n=0,2 do local ln=new("Frame",{Size=UDim2.fromOffset(14,2),Position=UDim2.new(0.5,-7,0.5,-5+n*5),BorderSizePixel=0},menuBtn); bind(ln,"BackgroundColor3","Sub"); round(ln,1) end
	menuBtn.MouseButton1Click:Connect(function() setCollapsed(not collapsed) end)
	local palBtn=new("TextButton",{Size=UDim2.fromOffset(26,26),Position=UDim2.new(1,-38,0.5,-13),BackgroundTransparency=1,Text=G.search,TextSize=15,AutoButtonColor=false},top)
	palBtn.MouseButton1Click:Connect(function() openPalette() end)
	local grip=new("TextButton",{Size=UDim2.fromOffset(24,24),Position=UDim2.new(1,-24,1,-24),BackgroundTransparency=1,Text="",ZIndex=25,AutoButtonColor=false},main)
	local gripDots={{16,16},{10,16},{4,16},{16,10},{10,10},{16,4}}
	for _,p in ipairs(gripDots) do local d=new("Frame",{Size=UDim2.fromOffset(3,3),Position=UDim2.fromOffset(p[1],p[2]),BorderSizePixel=0,ZIndex=26},grip); bind(d,"BackgroundColor3","Sub"); round(d,1) end
	local resizing,gStart,gSize=false,nil,nil
	grip.InputBegan:Connect(function(i)
		if isPress(i) then resizing=true; gStart=i.Position; gSize=curSize
			i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then resizing=false end end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if resizing and isMove(i) then
			local d=(i.Position-gStart)/uiScale.Scale
			curSize=UDim2.fromOffset(math.clamp(gSize.X.Offset+d.X,380,800),math.clamp(gSize.Y.Offset+d.Y,260,560))
			main.Size=curSize
		end
	end)
	local floatWrap=new("Frame",{Size=UDim2.fromOffset(52,52),Position=UDim2.new(0,16,0.5,-26),BackgroundTransparency=1},gui)
	local fBase={0.82,0.9,0.95}
	local fGlow=glowLayers(floatWrap,UDim2.new(0,0,0,0),52,52,26,nil,10,fBase)
	for n,g in ipairs(fGlow) do TweenService:Create(g,TweenInfo.new(1.4,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{BackgroundTransparency=fBase[n]+0.05}):Play() end
	local floatBtn=new("ImageButton",{Size=UDim2.new(1,0,1,0),Image=LOGO_IMAGE,ScaleType=Enum.ScaleType.Crop,AutoButtonColor=false},floatWrap)
	bind(floatBtn,"BackgroundColor3","Accent"); round(floatBtn,26)
	local fStroke=new("UIStroke",{Thickness=1.5,Transparency=0.3},floatBtn); bind(fStroke,"Color","Accent")
	local fst=drag(floatBtn,floatWrap)
	floatBtn.MouseButton1Click:Connect(function() if not fst.moved then setOpen(not open) end end)
	UIS.InputBegan:Connect(function(i,gp) if not gp and i.KeyCode==toggleKey then setOpen(not open) end end)
	local sideBg=new("Frame",{Size=UDim2.new(0,sideW,1,-44),Position=UDim2.new(0,0,0,44),BackgroundTransparency=0.45},main)
	bind(sideBg,"BackgroundColor3","Side"); round(sideBg,16)
	local side=new("ScrollingFrame",{Size=UDim2.new(1,0,1,-28),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},sideBg)
	new("UIListLayout",{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder},side)
	new("UIPadding",{PaddingTop=UDim.new(0,10),PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8)},side)
	local foot=new("TextLabel",{Size=UDim2.new(1,0,0,24),Position=UDim2.new(0,0,1,-26),BackgroundTransparency=1,Text="RRFMLY UI",Font=Enum.Font.Gotham,TextSize=11,TextStrokeTransparency=0.7},sideBg)
	bind(foot,"TextColor3","Sub")
	local pages=new("Frame",{Size=UDim2.new(1,-sideW,1,-44),Position=UDim2.new(0,sideW,0,44),BackgroundTransparency=1},main)
	local search=new("TextBox",{Size=UDim2.new(1,-24,0,30),Position=UDim2.new(0,12,0,10),Text="",PlaceholderText=G.search.."  Cari fitur...",ClearTextOnFocus=false,Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=0.3},pages)
	new("UIPadding",{PaddingLeft=UDim.new(0,12)},search)
	bind(search,"BackgroundColor3","Card"); bind(search,"TextColor3","Text"); bind(search,"PlaceholderColor3","Sub"); round(search,10)
	local tabs,current={},nil
	local function refreshTabs()
		for _,t in ipairs(tabs) do
			local sel=(t==current)
			t.btn.BackgroundColor3=Theme.Text; t.bar.BackgroundColor3=Theme.Accent
			tween(t.btn,0.2,{BackgroundTransparency=sel and 0.92 or 1})
			tween(t.bar,0.2,{BackgroundTransparency=sel and 0 or 1})
			t.txt.TextColor3=sel and Theme.Text or Theme.Sub
			local c=sel and Theme.Accent or Theme.Sub
			if t.icon:IsA("ImageLabel") then t.icon.ImageColor3=c
			elseif t.icon:IsA("TextLabel") then tween(t.icon,0.2,{TextTransparency=sel and 0 or 0.4})
			elseif t.icon:IsA("Frame") then
				for _,d in ipairs(t.icon:GetDescendants()) do if d:IsA("Frame") and d:GetAttribute("IconInk") then tween(d,0.2,{BackgroundColor3=c}) end end
			end
		end
	end
	table.insert(refreshers,refreshTabs)
	local function applyFilter()
		if not current then return end
		local q=search.Text:lower()
		for _,it in ipairs(current.items) do it.frame.Visible=(q=="") or (it.name~="" and it.name:lower():find(q,1,true)~=nil) end
	end
	search:GetPropertyChangedSignal("Text"):Connect(applyFilter)
	local function selectTab(t,instant)
		local changed=(current~=t); current=t
		for _,x in ipairs(tabs) do
			if x==t then
				x.page.Visible=true
				if changed and not instant then
					x.page.GroupTransparency=1; x.page.Position=UDim2.new(0,16,0,50)
					tween(x.page,0.3,{GroupTransparency=0,Position=UDim2.new(0,0,0,50)})
				else x.page.GroupTransparency=0; x.page.Position=UDim2.new(0,0,0,50) end
			else x.page.Visible=false end
		end
		refreshTabs(); applyFilter()
	end
	setCollapsed=function(state)
		collapsed=state and true or false; sideW=collapsed and 56 or SIDE
		tween(sideBg,0.3,{Size=UDim2.new(0,sideW,1,-44)})
		tween(pages,0.3,{Position=UDim2.new(0,sideW,0,44),Size=UDim2.new(1,-sideW,1,-44)})
		foot.Visible=not collapsed
		for _,t in ipairs(tabs) do
			if collapsed then t.txt.Visible=false
			else task.delay(0.15,function() if not collapsed then t.txt.Visible=true end end) end
		end
	end
	local palDim=new("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.45,Text="",AutoButtonColor=false,ZIndex=45,Visible=false},main)
	round(palDim,16)
	local palBox=new("Frame",{Size=UDim2.new(1,-40,1,-76),AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,56),Active=true},palDim)
	bind(palBox,"BackgroundColor3","Card"); round(palBox,14)
	new("UISizeConstraint",{MaxSize=Vector2.new(340,300)},palBox)
	local palStroke=new("UIStroke",{Thickness=1,Transparency=0.4},palBox); bind(palStroke,"Color","Line")
	local palInput=new("TextBox",{Size=UDim2.new(1,-24,0,34),Position=UDim2.new(0,12,0,12),Text="",PlaceholderText="Cari fitur... (Esc untuk tutup)",ClearTextOnFocus=false,Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left},palBox)
	new("UIPadding",{PaddingLeft=UDim.new(0,12)},palInput)
	bind(palInput,"BackgroundColor3","Bg"); bind(palInput,"TextColor3","Text"); bind(palInput,"PlaceholderColor3","Sub"); round(palInput,10)
	local palList=new("ScrollingFrame",{Size=UDim2.new(1,-24,1,-62),Position=UDim2.new(0,12,0,54),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},palBox)
	new("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},palList)
	local firstHit=nil
	closePalette=function() palDim.Visible=false; palInput:ReleaseFocus() end
	local function jumpTo(t,it)
		closePalette(); selectTab(t)
		task.delay(0.35,function()
			local sc=t.scroll
			if sc and it.frame.Parent then
				local y=it.frame.AbsolutePosition.Y-sc.AbsolutePosition.Y+sc.CanvasPosition.Y-8
				sc.CanvasPosition=Vector2.new(0,math.max(0,y))
			end
			if it.stroke then it.stroke.Color=Theme.Accent; it.stroke.Transparency=0; tween(it.stroke,1,{Transparency=0.85,Color=Color3.new(1,1,1)}) end
		end)
	end
	local function palRefresh()
		for _,ch in ipairs(palList:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
		firstHit=nil; local q=palInput.Text:lower(); local count=0
		for _,t in ipairs(tabs) do for _,it in ipairs(t.items) do
			if count>=40 then break end
			local hit=it.title and (q=="" or it.title:lower():find(q,1,true)~=nil or it.name:lower():find(q,1,true)~=nil)
			if hit then
				count=count+1; if not firstHit then firstHit={t,it} end
				local r=new("TextButton",{Size=UDim2.new(1,-6,0,34),BackgroundTransparency=0.3,Text="",AutoButtonColor=false,LayoutOrder=count},palList)
				bind(r,"BackgroundColor3","Bg"); round(r,8)
				local a=new("TextLabel",{Size=UDim2.new(1,-112,1,0),Position=UDim2.new(0,10,0,0),BackgroundTransparency=1,Text=it.title,Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},r)
				bind(a,"TextColor3","Text")
				local b=new("TextLabel",{Size=UDim2.new(0,100,1,0),Position=UDim2.new(1,-108,0,0),BackgroundTransparency=1,Text=t.name,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Right,TextTruncate=Enum.TextTruncate.AtEnd},r)
				bind(b,"TextColor3","Sub")
				r.MouseButton1Click:Connect(function() jumpTo(t,it) end)
			end
		end end
	end
	palInput:GetPropertyChangedSignal("Text"):Connect(palRefresh)
	palInput.FocusLost:Connect(function(enter,input)
		if enter and firstHit then jumpTo(firstHit[1],firstHit[2])
		elseif input and input.KeyCode==Enum.KeyCode.Escape then closePalette() end
	end)
	palDim.MouseButton1Click:Connect(function() closePalette() end)
	openPalette=function() palDim.Visible=true; palInput.Text=""; palRefresh(); palInput:CaptureFocus() end
	UIS.InputBegan:Connect(function(i,gp)
		if gp or not open then return end
		if i.KeyCode==Enum.KeyCode.K and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
			if palDim.Visible then closePalette() else openPalette() end
		end
	end)
	function Window:AddTab(name,icon)
		local Tab={items={}}
		local btn=new("TextButton",{Size=UDim2.new(1,0,0,38),BackgroundColor3=Theme.Text,BackgroundTransparency=1,Text="",AutoButtonColor=false},side)
		round(btn,10)
		local bar=new("Frame",{Size=UDim2.new(0,3,1,-16),Position=UDim2.new(0,0,0,8),BackgroundColor3=Theme.Accent,BackgroundTransparency=1,BorderSizePixel=0},btn)
		local icn=makeIcon(btn,icon,18)
		local txt=new("TextLabel",{Size=UDim2.new(1,-46,1,0),Position=UDim2.new(0,38,0,0),BackgroundTransparency=1,Text=name,Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},btn)
		txt.Visible=not collapsed
		attachTip(btn,name,function() return collapsed end)
		local group=new("CanvasGroup",{Size=UDim2.new(1,0,1,-50),Position=UDim2.new(0,0,0,50),BackgroundTransparency=1,Visible=false},pages)
		local page=new("ScrollingFrame",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y},group)
		new("UIListLayout",{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},page)
		new("UIPadding",{PaddingTop=UDim.new(0,4),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,14),PaddingBottom=UDim.new(0,12)},page)
		Tab.btn=btn; Tab.txt=txt; Tab.page=group; Tab.scroll=page; Tab.name=name; Tab.bar=bar; Tab.icon=icn
		table.insert(tabs,Tab); btn.MouseButton1Click:Connect(function() selectTab(Tab) end)
		if #tabs==1 then selectTab(Tab,true) end
		local function card(h,cname,ctitle)
			local f=new("Frame",{Size=UDim2.new(1,0,0,h),BackgroundTransparency=0.3,ClipsDescendants=true},page)
			bind(f,"BackgroundColor3","Card"); round(f,12)
			local st=new("UIStroke",{Color=Color3.new(1,1,1),Transparency=0.85,Thickness=1},f)
			table.insert(Tab.items,{frame=f,name=cname or "",title=ctitle,stroke=st})
			f.MouseEnter:Connect(function() tween(f,0.15,{BackgroundColor3=Theme.Hover}); tween(st,0.15,{Color=Theme.Accent,Transparency=0.5}) end)
			f.MouseLeave:Connect(function() tween(f,0.15,{BackgroundColor3=Theme.Card}); tween(st,0.15,{Color=Color3.new(1,1,1),Transparency=0.85}) end)
			return f
		end
		local function lbl(parent,text,key,size,font)
			local l=new("TextLabel",{Size=UDim2.new(1,-150,0,42),Position=UDim2.new(0,14,0,0),BackgroundTransparency=1,Text=text,Font=font or Enum.Font.GothamMedium,TextSize=size or 14,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},parent)
			bind(l,"TextColor3",key or "Text"); return l
		end
		local function header(c,h)
			local b=new("TextButton",{Size=UDim2.new(1,0,0,h or 42),BackgroundTransparency=1,Text="",AutoButtonColor=false},c)
			b.MouseButton1Down:Connect(function(x,y) ripple(c,x,y) end)
			return b
		end
		function Tab:AddSection(text)
			local f=new("Frame",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1},page)
			table.insert(Tab.items,{frame=f,name="",title=text})
			local l=new("TextLabel",{Size=UDim2.new(1,-8,1,0),Position=UDim2.new(0,4,0,4),BackgroundTransparency=1,Text=string.upper(text),Font=Enum.Font.GothamBold,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,TextStrokeTransparency=0.6},f)
			bind(l,"TextColor3","Sub")
		end
		function Tab:AddParagraph(ptitle,body)
			local c=card(0,ptitle.." "..body,ptitle)
			c.Size=UDim2.new(1,0,0,0); c.AutomaticSize=Enum.AutomaticSize.Y
			new("UIPadding",{PaddingTop=UDim.new(0,12),PaddingBottom=UDim.new(0,12),PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14)},c)
			new("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},c)
			local t=new("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text=ptitle,Font=Enum.Font.GothamBold,TextSize=14,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=1},c)
			bind(t,"TextColor3","Text")
			local b=new("TextLabel",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=body,Font=Enum.Font.Gotham,TextSize=12,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=2},c)
			bind(b,"TextColor3","Sub")
			return ctl(c,{SetText=function(_,x) b.Text=x end})
		end
		function Tab:AddButton(text,cb,confirmText)
			local c=card(42,text,text)
			local b=header(c); b.Text=text; b.Font=Enum.Font.GothamBold; b.TextSize=14
			bind(b,"TextColor3","Accent")
			b.MouseButton1Click:Connect(function()
				if confirmText then Window:Confirm(confirmText,cb)
				elseif cb then task.spawn(cb) end
			end)
			return ctl(c)
		end
		function Tab:AddToggle(text,default,cb)
			local state=default or false; local c=card(42,text,text); lbl(c,text)
			local track=new("TextButton",{Size=UDim2.fromOffset(46,26),Position=UDim2.new(1,-58,0,8),Text="",AutoButtonColor=false},c); round(track,13)
			local knob=new("Frame",{Size=UDim2.fromOffset(22,22),BackgroundColor3=Color3.new(1,1,1)},track); round(knob,11)
			local function paint(animate)
				local col=state and STATUS.Green or Theme.Off
				local pos=state and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11)
				if animate then tween(track,0.25,{BackgroundColor3=col}); tween(knob,0.25,{Position=pos})
				else track.BackgroundColor3=col; knob.Position=pos end
			end
			paint(false); table.insert(refreshers,function() paint(false) end)
			local function set(v,silent) state=v and true or false; paint(true); if not silent and cb then task.spawn(cb,state) end end
			track.MouseButton1Click:Connect(function() set(not state) end)
			return ctl(c,{Set=function(_,v,silent) set(v,silent) end,Get=function() return state end})
		end
		function Tab:AddSlider(text,min,max,default,cb)
			local value=default or min; local c=card(58,text,text)
			local l=lbl(c,text..": "..value); l.Size=UDim2.new(1,-28,0,30)
			local bar=new("Frame",{Size=UDim2.new(1,-28,0,6),Position=UDim2.new(0,14,0,40)},c)
			bind(bar,"BackgroundColor3","Off"); round(bar,3)
			local fill=new("Frame",{Size=UDim2.new((value-min)/(max-min),0,1,0)},bar)
			bind(fill,"BackgroundColor3","Accent"); round(fill,3)
			local sliding=false
			local function set(v,silent) value=math.clamp(math.floor(v),min,max); fill.Size=UDim2.new((value-min)/(max-min),0,1,0); l.Text=text..": "..value; if not silent and cb then task.spawn(cb,value) end end
			local function update(x) set(min+(max-min)*math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)) end
			bar.InputBegan:Connect(function(i) if isPress(i) then sliding=true; update(i.Position.X) end end)
			UIS.InputEnded:Connect(function(i) if isPress(i) then sliding=false end end)
			UIS.InputChanged:Connect(function(i) if sliding and isMove(i) then update(i.Position.X) end end)
			return ctl(c,{Set=function(_,v,silent) set(v,silent) end,Get=function() return value end})
		end
		function Tab:AddDropdown(text,options,default,cb)
			local cur=default or options[1]; local c=card(42,text,text); lbl(c,text)
			local val=new("TextLabel",{Size=UDim2.new(0,120,0,42),Position=UDim2.new(1,-134,0,0),BackgroundTransparency=1,Text=tostring(cur).." "..G.down,Font=Enum.Font.Gotham,TextSize=13,TextXAlignment=Enum.TextXAlignment.Right},c)
			bind(val,"TextColor3","Sub")
			local h=header(c)
			local list=new("Frame",{Size=UDim2.new(1,0,0,#options*30),Position=UDim2.new(0,0,0,42),BackgroundTransparency=1},c)
			new("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder},list)
			local isOpen=false
			local function toggle(s) isOpen=s; tween(c,0.25,{Size=UDim2.new(1,0,0,s and (42+#options*30) or 42)}) end
			local function set(v,silent) cur=v; val.Text=tostring(v).." "..G.down; if not silent and cb then task.spawn(cb,v) end end
			for _,opt in ipairs(options) do
				local ob=new("TextButton",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Text=tostring(opt),Font=Enum.Font.GothamMedium,TextSize=13,AutoButtonColor=false},list)
				bind(ob,"TextColor3","Text")
				ob.MouseButton1Click:Connect(function() set(opt); toggle(false) end)
			end
			h.MouseButton1Click:Connect(function() toggle(not isOpen) end)
			return ctl(c,{Set=function(_,v,silent) set(v,silent) end,Get=function() return cur end})
		end
		function Tab:AddGreeting()
			local c=card(58,"sapaan selamat datang","Sapaan")
			local a=new("TextLabel",{Size=UDim2.new(1,-28,0,28),Position=UDim2.new(0,14,0,6),BackgroundTransparency=1,Font=Enum.Font.GothamBold,TextSize=17,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},c)
			bind(a,"TextColor3","Text")
			local b=new("TextLabel",{Size=UDim2.new(1,-28,0,18),Position=UDim2.new(0,14,0,34),BackgroundTransparency=1,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left},c)
			bind(b,"TextColor3","Sub")
			local function upd()
				local h=tonumber(os.date("%H")); local g="Selamat malam"
				if h>=4 and h<11 then g="Selamat pagi" elseif h>=11 and h<15 then g="Selamat siang" elseif h>=15 and h<18 then g="Selamat sore" end
				a.Text=g..", "..plr.DisplayName.." "..G.wave; b.Text=os.date("%A, %d %B %Y")
			end
			upd(); task.spawn(function() while c.Parent do task.wait(30); upd() end end)
			return ctl(c)
		end
		function Tab:AddProfile()
			local c=card(84,"profil avatar nama username","Profil")
			glowLayers(c,UDim2.new(0,12,0,12),60,60,30,nil,9,{0.76,0.87,0.94})
			local ring=new("Frame",{Size=UDim2.fromOffset(60,60),Position=UDim2.new(0,12,0,12)},c); bind(ring,"BackgroundColor3","Bg"); round(ring,30)
			local rs=new("UIStroke",{Thickness=2},ring); bind(rs,"Color","Accent")
			local av=new("ImageLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,ScaleType=Enum.ScaleType.Crop},ring); round(av,30)
			task.spawn(function() local ok,img=pcall(function() return Players:GetUserThumbnailAsync(plr.UserId,Enum.ThumbnailType.AvatarBust,Enum.ThumbnailSize.Size150x150) end); if ok then av.Image=img end end)
			local function txt(y,h,text,size,font,key)
				local l=new("TextLabel",{Size=UDim2.new(1,-96,0,h),Position=UDim2.new(0,84,0,y),BackgroundTransparency=1,Text=text,Font=font,TextSize=size,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},c)
				bind(l,"TextColor3",key)
			end
			txt(13,22,plr.DisplayName,16,Enum.Font.GothamBold,"Text")
			txt(35,16,"@"..plr.Name,12,Enum.Font.GothamMedium,"Accent")
			txt(54,16,"ID "..plr.UserId.."  |  Akun "..plr.AccountAge.." hari",11,Enum.Font.Gotham,"Sub")
			return ctl(c)
		end
		function Tab:AddGraph(gtitle,sampler,maxV,unit,invert)
			local N=40; local c=card(96,gtitle.." grafik",gtitle.." (grafik)")
			local t=new("TextLabel",{Size=UDim2.new(0.6,0,0,22),Position=UDim2.new(0,14,0,6),BackgroundTransparency=1,Text=gtitle,Font=Enum.Font.GothamBold,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left},c)
			bind(t,"TextColor3","Sub")
			local v=new("TextLabel",{Size=UDim2.new(0.4,-14,0,22),Position=UDim2.new(0.6,0,0,6),BackgroundTransparency=1,Text="--",Font=Enum.Font.GothamBold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Right},c)
			bind(v,"TextColor3","Text")
			local area=new("Frame",{Size=UDim2.new(1,-28,0,56),Position=UDim2.new(0,14,0,32),BackgroundTransparency=1},c)
			local bars,vals={},{}
			for i=1,N do
				vals[i]=0
				local b=new("Frame",{AnchorPoint=Vector2.new(0,1),Size=UDim2.new(1/N,-2,0.03,0),Position=UDim2.new((i-1)/N,0,1,0),BorderSizePixel=0,BackgroundColor3=STATUS.Green},area)
				round(b,2); bars[i]=b
			end
			task.spawn(function()
				while c.Parent do
					local ok,s=pcall(sampler); if not ok then s=nil end
					table.remove(vals,1); table.insert(vals,s or 0)
					if s then v.Text=math.floor(s)..unit else v.Text="--" end
					for i,b in ipairs(bars) do
						local p=math.clamp(vals[i]/maxV,0.03,1); local q=p
						if invert then q=1-p end
						b.Size=UDim2.new(1/N,-2,p,0)
						if q>=0.6 then b.BackgroundColor3=STATUS.Green elseif q>=0.35 then b.BackgroundColor3=STATUS.Yellow else b.BackgroundColor3=STATUS.Red end
					end
					task.wait(0.5)
				end
			end)
			return ctl(c)
		end
		function Tab:AddStats()
			local c=card(64,"fps ping pemain uptime statistik server","Statistik Server")
			local names={"FPS","Ping","Pemain","Uptime"}; local vals={}
			for i,n in ipairs(names) do
				local x=(i-1)/4
				local k=new("TextLabel",{Size=UDim2.new(0.25,0,0,18),Position=UDim2.new(x,0,0,8),BackgroundTransparency=1,Text=n,Font=Enum.Font.GothamMedium,TextSize=11},c)
				bind(k,"TextColor3","Sub")
				local v=new("TextLabel",{Size=UDim2.new(0.25,0,0,28),Position=UDim2.new(x,0,0,26),BackgroundTransparency=1,Text="--",Font=Enum.Font.GothamBold,TextSize=14},c)
				if n=="FPS" or n=="Ping" then v.TextColor3=Theme.Text else bind(v,"TextColor3","Text") end
				vals[n]=v
			end
			task.spawn(function()
				while c.Parent do
					vals.FPS.Text=tostring(fpsNow)
					if fpsNow>=50 then vals.FPS.TextColor3=STATUS.Green elseif fpsNow>=30 then vals.FPS.TextColor3=STATUS.Yellow else vals.FPS.TextColor3=STATUS.Red end
					local ping=getPing()
					if ping then vals.Ping.Text=math.floor(ping).." ms"; if ping<=100 then vals.Ping.TextColor3=STATUS.Green elseif ping<=200 then vals.Ping.TextColor3=STATUS.Yellow else vals.Ping.TextColor3=STATUS.Red end
					else vals.Ping.Text="--" end
					vals.Pemain.Text=#Players:GetPlayers().."/"..Players.MaxPlayers
					local t=math.floor(workspace.DistributedGameTime)
					if t>=3600 then vals.Uptime.Text=string.format("%d:%02d:%02d",math.floor(t/3600),math.floor(t%3600/60),t%60)
					else vals.Uptime.Text=string.format("%d:%02d",math.floor(t/60),t%60) end
					task.wait(0.5)
				end
			end)
			return ctl(c)
		end
		function Tab:AddGameInfo()
			local c=card(92,"info game id job place nama","Info Game")
			local function row(i,key,value)
				local y=8+(i-1)*26
				local k=new("TextLabel",{Size=UDim2.new(0,64,0,24),Position=UDim2.new(0,14,0,y),BackgroundTransparency=1,Text=key,Font=Enum.Font.GothamMedium,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left},c)
				bind(k,"TextColor3","Sub")
				local v=new("TextLabel",{Size=UDim2.new(1,-92,0,24),Position=UDim2.new(0,80,0,y),BackgroundTransparency=1,Text=value,Font=Enum.Font.GothamBold,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},c)
				bind(v,"TextColor3","Text")
				return v
			end
			local gname=row(1,"Game",game.Name)
			row(2,"Place ID",tostring(game.PlaceId))
			row(3,"Job ID",game.JobId~="" and game.JobId or "Studio / lokal")
			task.spawn(function() local ok,info=pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end); if ok and info and info.Name then gname.Text=info.Name end end)
			return ctl(c)
		end
		function Tab:AddFriendsOnline()
			local para=Tab:AddParagraph("Teman di server","Memeriksa...")
			local function refresh()
				task.spawn(function()
					local names={}
					for _,p in ipairs(Players:GetPlayers()) do
						if p~=plr then local ok,f=pcall(function() return plr:IsFriendsWith(p.UserId) end); if ok and f then names[#names+1]=p.DisplayName end end
					end
					if #names>0 then para:SetText(#names.." teman: "..table.concat(names,", "))
					else para:SetText("Tidak ada teman di server ini") end
				end)
			end
			refresh()
			Players.PlayerAdded:Connect(refresh)
			Players.PlayerRemoving:Connect(function() task.delay(0.5,refresh) end)
			return para
		end
		function Tab:AddClock()
			local c=card(92,"jam waktu clock tanggal","Jam Digital")
			local function mk(color) return new("TextLabel",{Size=UDim2.new(1,0,0,48),Position=UDim2.new(0,0,0,8),BackgroundTransparency=1,Text="00:00:00",Font=Enum.Font.Code,TextSize=36,TextColor3=color},c) end
			local red=mk(Color3.fromRGB(255,40,80)); red.TextTransparency=1; red.ZIndex=2
			local cyan=mk(Color3.fromRGB(0,230,255)); cyan.TextTransparency=1; cyan.ZIndex=2
			local face=mk(Theme.Text); face.ZIndex=3
			bind(face,"TextColor3","Text")
			face.TextStrokeTransparency=0.7; face.TextStrokeColor3=Theme.Accent
			table.insert(refreshers,function() face.TextStrokeColor3=Theme.Accent end)
			local date=new("TextLabel",{Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,0,0,60),BackgroundTransparency=1,Text="",Font=Enum.Font.GothamMedium,TextSize=12},c)
			bind(date,"TextColor3","Sub")
			local scan=new("Frame",{Size=UDim2.new(1,-24,0,2),Position=UDim2.new(0,12,0,20),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=1,BorderSizePixel=0,ZIndex=4},c)
			local sym={"#","%","@","$","?","/","X","0","1"}
			task.spawn(function()
				while c.Parent do
					local t=os.date("%H:%M:%S")
					face.Text=t; red.Text=t; cyan.Text=t; date.Text=os.date("%A, %d %B %Y")
					if math.random()<0.07 then
						for _=1,math.random(3,6) do
							local g={}
							for ch in t:gmatch(".") do
								if ch~=":" and math.random()<0.22 then g[#g+1]=sym[math.random(#sym)]
								else g[#g+1]=ch end
							end
							face.Text=table.concat(g)
							face.Position=UDim2.new(0,math.random(-2,2),0,8)
							red.Position=UDim2.new(0,math.random(-7,-2),0,8+math.random(-2,2))
							cyan.Position=UDim2.new(0,math.random(2,7),0,8+math.random(-2,2))
							red.TextTransparency=0.25; cyan.TextTransparency=0.25
							scan.Position=UDim2.new(0,12,0,math.random(8,50)); scan.BackgroundTransparency=0.6
							task.wait(0.05)
						end
						face.Text=t; face.Position=UDim2.new(0,0,0,8)
						red.Position=UDim2.new(0,0,0,8); cyan.Position=UDim2.new(0,0,0,8)
						red.TextTransparency=1; cyan.TextTransparency=1; scan.BackgroundTransparency=1
					end
					task.wait(0.1)
				end
			end)
			return ctl(c)
		end
		return Tab
	end
	function Window:Confirm(text,onYes,onNo)
		local dim=new("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=1,Text="",AutoButtonColor=false,ZIndex=30},main)
		round(dim,16); tween(dim,0.2,{BackgroundTransparency=0.4})
		local box=new("Frame",{Size=UDim2.fromOffset(250,120),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0.5,0,0.5,0)},dim)
		bind(box,"BackgroundColor3","Card"); round(box,16)
		local bs=new("UIStroke",{Thickness=1,Transparency=0.5},box); bind(bs,"Color","Line")
		local sc=new("UIScale",{Scale=0.85},box); tween(sc,0.25,{Scale=1})
		local t=new("TextLabel",{Size=UDim2.new(1,-28,0,60),Position=UDim2.new(0,14,0,8),BackgroundTransparency=1,Text=text,Font=Enum.Font.GothamMedium,TextSize=14,TextWrapped=true},box)
		bind(t,"TextColor3","Text")
		local function close(cb) tween(dim,0.15,{BackgroundTransparency=1}); tween(sc,0.15,{Scale=0.85}); task.delay(0.16,function() dim:Destroy() end); if cb then task.spawn(cb) end end
		local no=new("TextButton",{Size=UDim2.new(0.5,-18,0,34),Position=UDim2.new(0,12,1,-46),Text="Batal",Font=Enum.Font.GothamBold,TextSize=13,AutoButtonColor=false},box)
		bind(no,"BackgroundColor3","Bg"); bind(no,"TextColor3","Text"); round(no,10)
		local yes=new("TextButton",{Size=UDim2.new(0.5,-18,0,34),Position=UDim2.new(0.5,6,1,-46),Text="Ya",Font=Enum.Font.GothamBold,TextSize=13,TextColor3=Color3.new(1,1,1),AutoButtonColor=false},box)
		bind(yes,"BackgroundColor3","Accent"); round(yes,10)
		no.MouseButton1Click:Connect(function() close(onNo) end)
		yes.MouseButton1Click:Connect(function() close(onYes) end)
	end
	local liveToasts,TOAST_LIMIT={},5
	local holder=new("Frame",{Size=UDim2.new(0,300,1,-20),Position=UDim2.new(1,-312,0,0),BackgroundTransparency=1},gui)
	new("UIListLayout",{Padding=UDim.new(0,8),VerticalAlignment=Enum.VerticalAlignment.Bottom,SortOrder=Enum.SortOrder.LayoutOrder},holder)
	local TOAST_BLUE_TOP=Color3.fromRGB(48,92,186)
	local TOAST_BLUE_MID=Color3.fromRGB(28,58,130)
	local TOAST_BLUE_LOW=Color3.fromRGB(16,32,76)
	local TOAST_BLUE_STROKE=Color3.fromRGB(104,158,246)
	local TOAST_TEXT_SUB=Color3.fromRGB(206,220,246)
	function Window:Notify(text,kind,duration,opts)
		if type(text)=="table" then opts=text; text=opts.body or opts.title or ""; kind=opts.kind; duration=opts.duration end
		opts=opts or {}; kind=kind or opts.kind or "info"
		local isLoading=opts.progress==true
		duration=duration or opts.duration or (isLoading and math.huge or 3.5)
		local kindColor=Theme.Accent; local label="Notifikasi"
		if kind=="success" then kindColor=STATUS.Green; label="Berhasil"
		elseif kind=="error" then kindColor=STATUS.Red; label="Kesalahan"
		elseif kind=="warn" then kindColor=STATUS.Yellow; label="Peringatan" end
		local titleText=opts.title or label
		local bodyText=text
		while #liveToasts>=TOAST_LIMIT do
			local old=table.remove(liveToasts,1)
			if old then if old.dismiss then old.dismiss() elseif old.wrap and old.wrap.Parent then old.wrap:Destroy() end end
		end
		local wrap=new("Frame",{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1,ClipsDescendants=true},holder)
		local box=new("Frame",{Size=UDim2.new(1,0,0,72),Position=UDim2.new(0,0,0,4),BackgroundColor3=Color3.new(1,1,1),ClipsDescendants=true},wrap)
		round(box,14)
		new("UIGradient",{Rotation=90,Color=ColorSequence.new({ColorSequenceKeypoint.new(0,TOAST_BLUE_TOP),ColorSequenceKeypoint.new(0.55,TOAST_BLUE_MID),ColorSequenceKeypoint.new(1,TOAST_BLUE_LOW)})},box)
		local bStroke=new("UIStroke",{Thickness=1,Transparency=0.45,Color=TOAST_BLUE_STROKE},box)
		local badge=new("Frame",{Size=UDim2.fromOffset(32,32),Position=UDim2.new(0,20,0.5,-16),BackgroundColor3=kindColor,BackgroundTransparency=0.1,BorderSizePixel=0},box)
		round(badge,16)
		local close=new("TextButton",{Size=UDim2.fromOffset(20,20),Position=UDim2.new(1,-26,0,8),BackgroundTransparency=1,Text="",AutoButtonColor=false},box)
		for _,rot in ipairs({45,-45}) do
			local bar=new("Frame",{Size=UDim2.fromOffset(10,1.5),Position=UDim2.new(0.5,-5,0.5,-0.75),BorderSizePixel=0,Rotation=rot,BackgroundColor3=Color3.fromRGB(180,208,245)},close)
			round(bar,1)
		end
		local title=new("TextLabel",{Size=UDim2.new(1,-110,0,18),Position=UDim2.new(0,64,0,12),BackgroundTransparency=1,Text=titleText,Font=Enum.Font.GothamBold,TextSize=13,TextColor3=Color3.new(1,1,1),TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},box)
		local body=new("TextLabel",{Size=UDim2.new(1,-76,0,26),Position=UDim2.new(0,64,0,32),BackgroundTransparency=1,Text=bodyText,Font=Enum.Font.Gotham,TextSize=12,TextWrapped=true,TextColor3=TOAST_TEXT_SUB,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top},box)
		local track=new("Frame",{Size=UDim2.new(1,-24,0,3),Position=UDim2.new(0,12,1,-9),BackgroundColor3=kindColor,BackgroundTransparency=0.65,BorderSizePixel=0},box)
		round(track,1.5)
		local fill=new("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=kindColor},track)
		round(fill,1.5)
		local indetTween=nil
		if isLoading then
			fill.Size=UDim2.new(0,0,1,0)
			indetTween=TweenService:Create(fill,TweenInfo.new(1.2,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{Size=UDim2.new(1,0,1,0)})
			indetTween:Play()
		else
			TweenService:Create(fill,TweenInfo.new(duration,Enum.EasingStyle.Linear),{Size=UDim2.new(0,0,1,0)}):Play()
		end
		local sc=new("UIScale",{Scale=0.85},box)
		box.BackgroundTransparency=1; bStroke.Transparency=1
		tween(wrap,0.3,{Size=UDim2.new(1,0,0,80)})
		tween(sc,0.35,{Scale=1})
		tween(box,0.25,{BackgroundTransparency=0})
		tween(bStroke,0.3,{Transparency=0.45})
		local toast={wrap=wrap}; table.insert(liveToasts,toast)
		local dismissed=false
		local function dismiss()
			if dismissed then return end; dismissed=true
			if indetTween then indetTween:Cancel(); indetTween=nil end
			tween(wrap,0.28,{Size=UDim2.new(1,0,0,0)})
			tween(sc,0.25,{Scale=0.85})
			tween(box,0.22,{BackgroundTransparency=1})
			tween(bStroke,0.22,{Transparency=1})
			for i=#liveToasts,1,-1 do if liveToasts[i]==toast then table.remove(liveToasts,i); break end end
			task.delay(0.32,function() if wrap and wrap.Parent then wrap:Destroy() end end)
		end
		toast.dismiss=dismiss
		close.MouseButton1Click:Connect(dismiss)
		if not isLoading then task.delay(duration,dismiss) end
		local api={
			Dismiss=dismiss,
			SetTitle=function(_,s) title.Text=s end,
			SetText=function(_,s) body.Text=s end,
			SetProgress=function(_,p) if dismissed then return end; if indetTween then indetTween:Cancel(); indetTween=nil end; fill.Size=UDim2.new(math.clamp(p,0,1),0,1,0) end,
			Finish=function(_,ok,msg)
				if dismissed then return end
				if indetTween then indetTween:Cancel(); indetTween=nil end
				fill.Size=UDim2.new(1,0,1,0)
				if ok==false then badge.BackgroundColor3=STATUS.Red; track.BackgroundColor3=STATUS.Red; fill.BackgroundColor3=STATUS.Red; title.Text=msg or (titleText.." gagal")
				else badge.BackgroundColor3=STATUS.Green; track.BackgroundColor3=STATUS.Green; fill.BackgroundColor3=STATUS.Green; if msg then title.Text=msg end end
				task.delay(1.2,dismiss)
			end
		}
		return api
	end
	function Window:SetTheme(n) if Themes[n] then for k,v in pairs(Themes[n]) do Theme[k]=v end; applyTheme() end end
	function Window:SetAccent(c) Theme.Accent=c; applyTheme() end
	function Window:SetOverlay(t) tween(overlay,0.25,{BackgroundTransparency=math.clamp(t,0,1)}) end
	function Window:SetScale(s) tween(uiScale,0.25,{Scale=s}) end
	function Window:SetHud(on) hudEnabled=on and true or false; updateHud() end
	function Window:SetSidebarCollapsed(on) setCollapsed(on) end
	function Window:OpenPalette() openPalette() end
	function Window:Toggle() setOpen(not open) end
	function Window:Destroy() gui:Destroy() end
	return Window
end

