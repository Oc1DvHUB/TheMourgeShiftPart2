end, "Keluar dan masuk lagi ke server ini?")

-- ✅ SHARED VARIABLES untuk sync antar tab
local tNoclipColl, tNoclipFarm
local tFarm, tSolo, tMini, tTween

-- TAB: FARM TASK 💀
local farmTask = Win:AddTab("FARM TASK", utf8.char(128128))
task.spawn(function()
	local API = getgenv().MorgueAPI
	if not API then for _=1,20 do task.wait(0.3); API=getgenv().MorgueAPI; if API then break end end end
	if not API then Win:Notify("Morgue engine tidak ditemukan!", "error", 5); return end

	farmTask:AddSection("Auto Farm")
	tFarm = farmTask:AddToggle("Auto Farm Shift", API.IsAutoFarm(), function(v) API.SetAutoFarm(v) end)
	tSolo = farmTask:AddToggle("Auto Start Solo", API.IsAutoStartSolo(), function(v) API.SetAutoStartSolo(v) end)
	tMini = farmTask:AddToggle("Minigame Solver", API.IsAutoMinigame(), function(v) API.SetAutoMinigame(v) end)

	farmTask:AddSection("Movement")
	tNoclipFarm = farmTask:AddToggle("Noclip", API.IsNoclip(), function(v)
		API.SetNoclip(v)
		if tNoclipColl and tNoclipColl.Set then pcall(function() tNoclipColl:Set(v, true) end) end
	end)
	tTween = farmTask:AddToggle("Tween Mode (Slow)", API.IsTweenMode(), function(v) API.SetTweenMode(v) end)

	farmTask:AddSection("Status")
	local statPara = farmTask:AddParagraph("Status", "Ready")
	local statsPara = farmTask:AddParagraph("Stats", "Shifts: 0 | Mini: 0 | JS: 0 | Calls: 0")

	farmTask:AddSection("Kontrol")
	farmTask:AddButton("Reset Shift Latched", function() API.ResetShiftLatched(); Win:Notify("Reset","success",2) end)
	farmTask:AddButton("Unload Engine", function() if API.Unload then API.Unload() end; Win:Notify("Engine unloaded","warn",3) end, "Yakin unload engine?")

	task.spawn(function() while task.wait(0.6) do
		if not getgenv().MorgueAPI then if statPara and statPara.SetText then statPara:SetText("Engine offline") end; break end
		local ok, msg = pcall(function() local m,p = API.GetStatus(); return m.."  ["..p.."]" end)
		local okS, st = pcall(function() return API.GetStats() end)
		if ok and statPara and statPara.SetText then statPara:SetText(msg) end
		if okS and statsPara and statsPara.SetText then statsPara:SetText(string.format("Shifts: %d | Mini: %d | JS: %d | Calls: %d", st.ShiftsCompleted, st.MinigamesSolved, st.JumpscaresCleared, st.CallsHandled)) end
		if tFarm and tFarm.Set then pcall(function() tFarm:Set(API.IsAutoFarm(),true) end) end
		if tSolo and tSolo.Set then pcall(function() tSolo:Set(API.IsAutoStartSolo(),true) end) end
		if tMini and tMini.Set then pcall(function() tMini:Set(API.IsAutoMinigame(),true) end) end
		if tNoclipFarm and tNoclipFarm.Set then pcall(function() tNoclipFarm:Set(API.IsNoclip(),true) end) end
		if tNoclipColl and tNoclipColl.Set then pcall(function() tNoclipColl:Set(API.IsNoclip(),true) end) end
		if tTween and tTween.Set then pcall(function() tTween:Set(API.IsTweenMode(),true) end) end
	end end)
	Win:Notify("FARM TASK loaded", "success", 3)
end)

-- TAB: COLLECT 🍬 (dengan Noclip + fixed ocWalk)
local coll = Win:AddTab("Collect", utf8.char(127852))
coll:AddSection("Candy")
