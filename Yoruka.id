-- TAB: SETTINGS ⚙
local settings = Win:AddTab("Settings", {drawn = "gear"})
settings:AddSection("Kontrol")
settings:AddParagraph("Info", "Toggle UI: RightShift\nKlik logo 👻 untuk toggle\nCtrl+K untuk Command Palette\nDrag logo untuk pindah posisi")
settings:AddSection("Danger Zone")
settings:AddButton("Unload Semua", function()
	Win:Notify("Unloading...","warn",2); task.wait(0.5)
