local OC = {
	AutoCollectCandy=false, AutoCollectPumpkin=false,
	CandyInterval=2, CandyWalkSpeed=32, CandyTimeout=120, CandyMethod="walk",
	PumpkinInterval=2, PumpkinMethod="walk", PromptBypass="Simulate",
	ItemESP=false, PumpkinESP=false, ReaperESP=false, GhostESP=false, ShowDistance=false,
	Fly=false, FlySpeed=80, FlyKey=Enum.KeyCode.F, Invisible=false, GodMode=false,
	WalkSpeedEnabled=false, WalkSpeedValue=16,
	SpeedhackEnabled=false, SpeedhackValue=60, SpeedhackAntiDetect=true,
	InfiniteJump=false,
	AntiAFK=true, AntiAFKInterval=90, AntiDetect=true,
	AntiFling=true, AntiVoid=true, AutoRespawn=true,
	Fullbright=false, NoFog=false, FPSUnlock=false,
	Stats={ItemsFound=0,ItemsCollected=0,ItemsAttempted=0,PumpkinsFound=0,PumpkinsCollected=0,
		PumpkinsAttempted=0,ReapersFound=0,GhostsFound=0,AFKTicks=0,CandiesCollected=0}
}
local itemCache,pumpkinCache,reaperCache,ghostCache = {},{},{},{}
local countedItems,countedPumpkins = {},{}
local antiDetect = {Enabled=true,Running=false,KicksBlocked=0,RemotesBlocked=0,MovementBlocked=0,lastPos=nil,lastTime=nil}
local DETECT_KW = {"detect","anticheat","anti_cheat","ac_","log","report","flag","ban","kick","admin","cheat","hack","exploit","suspicious","monitor","watch","check","verify","suspect"}
local function isDetName(n) local l=tostring(n):lower(); for _,k in ipairs(DETECT_KW) do if l:find(k,1,true) then return true end end return false end

pcall(function()
	if type(hookfunction)=="function" then hookfunction(localPlayer.Kick,function(self,...) if self==localPlayer and OC.AntiDetect then antiDetect.KicksBlocked+=1 return end end) end
	if type(hookmetamethod)=="function" then
		local oi,on
		oi=hookmetamethod(game,"__index",function(self,key)
			if OC.SpeedhackAntiDetect and OC.SpeedhackEnabled and key=="WalkSpeed" then
				local ok,ish=pcall(function() return self:IsA("Humanoid") end)
				if ok and ish and localPlayer.Character then local h=localPlayer.Character:FindFirstChildOfClass("Humanoid"); if h==self then return 16 end end
			end
			return oi(self,key)
		end)
		on=hookmetamethod(game,"__namecall",function(self,...)
			local m=getnamecallmethod()
			if antiDetect.Enabled then
				if m=="Kick" and self==localPlayer then antiDetect.KicksBlocked+=1 return end
				if m=="FireServer" or m=="InvokeServer" then
					local ok,n=pcall(function() return self:GetFullName() end)
					if ok and isDetName(n) then antiDetect.RemotesBlocked+=1 return end
				end
			end
			return on(self,...)
		end)
	end
end)

local function getHRP() local c=localPlayer.Character; return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")) end
local function getHum() local c=localPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function hasChar() return localPlayer.Character and localPlayer.Character.Parent and getHRP()~=nil end

task.spawn(function()
	while not State.Unloaded do
		RunService.Heartbeat:Wait()
		if not OC.AntiDetect or not antiDetect.Running or not hasChar() then antiDetect.lastPos=nil; antiDetect.lastTime=nil; continue end
		local hrp=getHRP(); if not hrp then continue end
		local now,pos=tick(),hrp.Position
		if antiDetect.lastPos and antiDetect.lastTime then
			local dd,dt=(pos-antiDetect.lastPos).Magnitude,now-antiDetect.lastTime
			local sp=dt>0 and (dd/dt) or 0
			if dd>80 or (not OC.Fly and not OC.SpeedhackEnabled and sp>100) then antiDetect.MovementBlocked+=1; pcall(function() hrp.CFrame=CFrame.new(antiDetect.lastPos) end) end
		end
		antiDetect.lastPos,antiDetect.lastTime=hrp.Position,now
	end
end)

task.spawn(function() while not State.Unloaded do task.wait(OC.AntiAFKInterval); if OC.AntiAFK then pcall(function() VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()); OC.Stats.AFKTicks+=1 end) end end end)
pcall(function() localPlayer.Idled:Connect(function() if OC.AntiAFK then pcall(function() VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end) end end) end)

task.spawn(function()
	while not State.Unloaded do
		task.wait(0.5); local c=localPlayer.Character
