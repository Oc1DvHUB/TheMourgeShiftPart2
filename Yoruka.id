tNoclipColl = coll:AddToggle("Noclip (Tembus Tembok)", (State and State.Noclip) or false, function(v)
	local api = getgenv().MorgueAPI
	if api and api.SetNoclip then
		api.SetNoclip(v)
	else
		local char = Players.LocalPlayer.Character
		if char then
			for _,d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") then d.CanCollide = not v end
			end
		end
	end
	if tNoclipFarm and tNoclipFarm.Set then pcall(function() tNoclipFarm:Set(v, true) end) end
end):SetTooltip("Aktifkan saat collect candy/pumpkin biar tembus tembok")
local collectStats = coll:AddParagraph("Collected", "Candy: 0 | Pumpkin: 0")
