	end
end)

task.spawn(function()
	while not State.Unloaded do
		task.wait(2)
		if OC.AutoRespawn and localPlayer.Character then
			local h=getHum()
			if h and h.Health<=0 then task.wait(1.5) pcall(function()
				local gp=ReplicatedStorage:FindFirstChild("Gameplay"); local rh=gp and gp:FindFirstChild("RespawnHandler")
				if rh and rh:IsA("RemoteEvent") then rh:FireServer() end
			end) end
		end
	end
end)

task.spawn(function()
	while not State.Unloaded do task.wait(1)
		if OC.FPSUnlock then pcall(function() if type(sethiddenproperty)=="function" then sethiddenproperty(RunService,"MaxFPS",999) end; if setfpscap then setfpscap(999) end end) end
	end
end)

local flyBV,flyBG,flyConn
local function stopFly()
	if flyBV then pcall(function() flyBV:Destroy() end); flyBV=nil end
	if flyBG then pcall(function() flyBG:Destroy() end); flyBG=nil end
	if flyConn then pcall(function() flyConn:Disconnect() end); flyConn=nil end
end
local function startFly()
	stopFly(); if not hasChar() then return end
	local hrp,hum=getHRP(),getHum(); if not hrp or not hum then return end
	flyBV=Instance.new("BodyVelocity"); flyBV.MaxForce=Vector3.new(math.huge,math.huge,math.huge); flyBV.Velocity=Vector3.zero; flyBV.Parent=hrp
	flyBG=Instance.new("BodyGyro"); flyBG.MaxTorque=Vector3.new(math.huge,math.huge,math.huge); flyBG.P=9e4; flyBG.D=500; flyBG.CFrame=hrp.CFrame; flyBG.Parent=hrp
	flyConn=RunService.RenderStepped:Connect(function()
		if not OC.Fly or not hasChar() then return end
		local h,hm=getHRP(),getHum(); if not h or not hm then return end
		local dir=Vector3.zero
		if hm.MoveDirection.Magnitude>0 then dir=hm.MoveDirection end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir+Vector3.new(0,-1,0) end
		if dir.Magnitude>0 then dir=dir.Unit end
		flyBV.Velocity=dir*OC.FlySpeed; flyBG.CFrame=workspace.CurrentCamera.CFrame
	end)
end
UIS.InputBegan:Connect(function(i,g) if not g and i.KeyCode==OC.FlyKey then OC.Fly=not OC.Fly; if OC.Fly then startFly() else stopFly() end end end)
localPlayer.CharacterAdded:Connect(function() task.wait(1); if OC.Fly then startFly() end end)

local ITEM_KW={"trickortreatitem","trickortreat","trick_or_treat","trick","treat","candy","candies","sweet","halloweenitem","eventitem","collectitem","pickupitem"}
local ITEM_BL={"prompt","ui","gui","shop","sign","spawner","spawn","effect","sound","particle","highlight","button","text","label","screen","folder"}
local PUM_KW={"spookypumpkin","spooky_pumpkin","spooky pumpkin","pumpkin","pumkin","jacko","jackolantern","jack_o_lantern","halloweenpumpkin","pumpkinitem","pumpkin_item"}
local PUM_BL={"prompt","ui","gui","shop","sign","spawner","spawn","effect","sound","particle","highlight","button","text","label","screen","folder","decal","texture","mesh","light","beam","trail"}
local GHOST_KW={"ghost","hantu","spirit","phantom","wraith","soul","specter","spectre","haunt","poltergeist","banshee","revenant","demon","devil","monster","zombie","skeleton","skull","shadow","nightmare","undead","curse"}
local GHOST_BL={"ghostbuster","ghost_shop","ghostsign","ghost_ui","soulmate","soul_shop","console","shining","souvenir"}
local function checkN(name,kw,bl) local l=name:lower(); for _,b in ipairs(bl) do if l:find(b,1,true) then return false end end; for _,k in ipairs(kw) do if l:find(k,1,true) then return true end end return false end
local function extractPart(o)
	if not o or not o.Parent then return nil end
	if o:IsA("BasePart") or o:IsA("MeshPart") then return o end
	if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart") or o:FindFirstChildWhichIsA("MeshPart") end
	if o:IsA("Tool") then return o:FindFirstChildWhichIsA("BasePart") end
	if o:IsA("Folder") then return o:FindFirstChildWhichIsA("BasePart",true) end
	return nil
end
local function scanByKW(kw,bl,excl)
	local found,seen={},{}
	pcall(function() for _,o in ipairs(workspace:GetDescendants()) do
		if not o.Parent or seen[o] then continue end
		if checkN(o.Name,kw,bl) then
			if excl and checkN(o.Name,excl,{}) then continue end
			local part=extractPart(o)
			if part and part.Parent then
				local root=part:FindFirstAncestorOfClass("Model") or o
				if not seen[root] then seen[root]=true; table.insert(found,{model=root,part=part,name=o.Name,source=o}) end
			end
		end
	end end)
	return found
end
local function scanItems() return scanByKW(ITEM_KW,ITEM_BL,PUM_KW) end
local function scanPumpkins() return scanByKW(PUM_KW,PUM_BL,ITEM_KW) end
local function scanReapers()
	local f={}
	pcall(function() for _,o in ipairs(workspace:GetDescendants()) do
		if o:IsA("Model") then local n=o.Name:lower()
			if (n:find("reaper") or n:find("death") or n:find("grim")) and not Players:GetPlayerFromCharacter(o) then
				local p=extractPart(o); if p then table.insert(f,{model=o,part=p}) end
			end
		end
	end end)
	return f
end
local function scanGhosts()
	local found,seen={},{}
	pcall(function() for _,o in ipairs(workspace:GetDescendants()) do
		if o:IsA("Model") and not Players:GetPlayerFromCharacter(o) then
			local n=o.Name:lower(); local bl=false
			for _,b in ipairs(GHOST_BL) do if n:find(b,1,true) then bl=true; break end end
			if not bl then for _,kw in ipairs(GHOST_KW) do
				if n==kw or n:find("^"..kw.."_") or n:find("^"..kw.." ") or n:find(" "..kw.." ") or n:find(" "..kw.."$") then
					local hum=o:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health>0 and not seen[o] then seen[o]=true; local p=extractPart(o)
						if p then table.insert(found,{model=o,part=p,name=o.Name}) end
					end
					break
				end
			end end
		end
	end end)
	return found
end
local scanCache={items={},pumpkins={},lastUpdate=0}
local function refreshCache() if tick()-scanCache.lastUpdate>0.8 then scanCache.items=scanItems(); scanCache.pumpkins=scanPumpkins(); scanCache.lastUpdate=tick() end end
local function getCI() refreshCache(); return scanCache.items end
local function getCP() refreshCache(); return scanCache.pumpkins end

-- ✅ FIXED ocWalk: support noclip direct move
local function ocWalk(tp,timeout,speed)
	timeout=timeout or 120; speed=speed or 32
	if not hasChar() or not tp or not tp.Parent then return false end
	local hrp,hum=getHRP(),getHum(); if not hrp or not hum then return false end
	local os_=hum.WalkSpeed; hum.WalkSpeed=speed
	local success,st=false,tick()
	if (hrp.Position-tp.Position).Magnitude<5 then hum.WalkSpeed=os_; return true end

	-- === NOCLIP MODE: direct move, no pathfinding ===
	local isNoclip = (State and State.Noclip) or OC.Invisible or OC.Fly
	if isNoclip then
		local char=localPlayer.Character
		if char then
			for _,d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") and d.CanCollide then d.CanCollide=false end
			end
		end
		local lastPos=hrp.Position; local stuckT=0
		while tick()-st<timeout do
			if not hasChar() or not tp.Parent then break end
			local c,h,r=localPlayer.Character,getHum(),getHRP()
			if not (c and h and r) then break end
			if h.Health<=0 then break end
			if (r.Position-tp.Position).Magnitude<=5 then success=true; break end
			local dir = tp.Position - r.Position
			if dir.Magnitude>0.1 then h:Move(dir.Unit) end
			if (r.Position-lastPos).Magnitude<0.3 then
				stuckT+=0.1
				if stuckT>1 then h.Jump=true; stuckT=0 end
			else stuckT=0 end
			lastPos=r.Position
			for _,d in ipairs(c:GetDescendants()) do
				if d:IsA("BasePart") and d.CanCollide then d.CanCollide=false end
			end
			task.wait(0.05)
		end
		if hum then pcall(function() hum:Move(Vector3.zero) end) end
		hum.WalkSpeed=os_
		return success
	end
	-- === END NOCLIP MODE ===

	-- Mode normal: pakai PathfindingService
	local path=PathfindingService:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,AgentCanClimb=true,WaypointSpacing=8})
	local ok=pcall(function() path:ComputeAsync(hrp.Position,tp.Position) end)
	if ok and path.Status==Enum.PathStatus.Success then
		for _,wp in ipairs(path:GetWaypoints()) do
			if tick()-st>timeout then break end
			if not hasChar() or not tp.Parent then break end
			if wp.Action==Enum.PathWaypointAction.Jump then pcall(function() hum.Jump=true end); task.wait(0.2) end
			pcall(function() hum:MoveTo(wp.Position) end)
			local ws=tick()
			while tick()-ws<5 do
				if tick()-st>timeout then break end
				if not hasChar() then break end
				local h2=getHRP(); if not h2 then break end
				if (h2.Position-wp.Position).Magnitude<3.5 then break end
				task.wait(0.08)
			end
			task.wait(0.03)
		end
		if hasChar() and tp.Parent then success=(getHRP().Position-tp.Position).Magnitude<10 end
	end
	if not success then
		local fs,lpt=tick(),tick(); local ld=(getHRP().Position-tp.Position).Magnitude; local stuck=0
		while tick()-fs<timeout do
			if not hasChar() or not tp.Parent then break end
			local h=getHRP(); if not h then break end
			local dir=tp.Position-h.Position; local dist=dir.Magnitude
			if dist<5 then success=true; break end
			local now=tick()
			if math.abs(ld-dist)<0.8 then
				if now-lpt>2.5 then pcall(function() hum.Jump=true end); stuck+=1; lpt=now
					if stuck>=5 then local s=Vector3.new(dir.Unit.Z,0,-dir.Unit.X)*10; pcall(function() hum:MoveTo(h.Position+s) end); task.wait(0.6); stuck=0 end
				end
			else lpt=now; ld=dist end
			local fd=Vector3.new(dir.X,0,dir.Z)
			if fd.Magnitude>0 then pcall(function() hum:MoveTo(h.Position+fd.Unit*math.min(dist,12)) end) end
			task.wait(0.1)
		end
	end
	if hasChar() then pcall(function() hum:MoveTo(getHRP().Position) end) end
	hum.WalkSpeed=os_; return success
end

local function collectItem(data)
	if not data or not data.part or not data.part.Parent then return false end
	local part,model=data.part,data.model; local hrp=getHRP(); if not hrp then return false end
	if (part.Position-hrp.Position).Magnitude>15 then return false end
	local claimed,prompts=false,{}
	local pM=model:FindFirstChildWhichIsA("ProximityPrompt",true); if pM then table.insert(prompts,pM) end
	local pP=part:FindFirstChildWhichIsA("ProximityPrompt"); if pP and pP~=pM then table.insert(prompts,pP) end
	if #prompts>0 then
		for _,pr in ipairs(prompts) do
			local oH,oD=pr.HoldDuration,pr.MaxActivationDistance
			if OC.PromptBypass=="Simulate" then
				pcall(function() pr.MaxActivationDistance=math.max(oD,20); pr.Enabled=true end)
				pcall(function() if pr.PromptButtonHoldBegan then pr.PromptButtonHoldBegan:Fire(localPlayer) end end)
				task.wait(math.max(oH,0.1))
				pcall(function() if fireproximityprompt then fireproximityprompt(pr,0) end end)
			elseif OC.PromptBypass=="Alternative" then
				local cM=model:FindFirstChildWhichIsA("ClickDetector",true)
				if cM and fireclickdetector then pcall(function() fireclickdetector(cM) end); task.wait(0.1)
				elseif firetouchinterest then pcall(function() firetouchinterest(hrp,part,0); task.wait(0.05); firetouchinterest(hrp,part,1) end); task.wait(0.1) end
				if part.Parent and model.Parent then pcall(function() pr.HoldDuration=0; pr.MaxActivationDistance=9e9; if fireproximityprompt then fireproximityprompt(pr,0) end end) end
			else
				pcall(function() pr.MaxActivationDistance=9e9; pr.HoldDuration=0; pr.Enabled=true; if fireproximityprompt then fireproximityprompt(pr,0) end end)
			end
			task.wait(0.1)
			if not part.Parent or not model.Parent then claimed=true; break end
		end
	else
		local cM=model:FindFirstChildWhichIsA("ClickDetector",true)
		if cM and fireclickdetector then pcall(function() fireclickdetector(cM) end); task.wait(0.1) end
		if firetouchinterest then pcall(function() firetouchinterest(hrp,part,0); task.wait(0.05); firetouchinterest(hrp,part,1) end); task.wait(0.1) end
		if not part.Parent or not model.Parent then claimed=true end
	end
	return claimed
end
local function createHL(model,color,name)
	if not model or not model.Parent then return end
	local e=model:FindFirstChild(name); if e then e:Destroy() end
	local hl=Instance.new("Highlight"); hl.Name=name; hl.FillColor=color; hl.OutlineColor=Color3.fromRGB(255,255,255)
	hl.FillTransparency=0.6; hl.OutlineTransparency=0.1; hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee=model; hl.Parent=model
end
local function createTag(part,label,color,tagName)
	if not part or not part.Parent then return end
	local e=part:FindFirstChild(tagName); if e then e:Destroy() end
	local bb=Instance.new("BillboardGui"); bb.Name=tagName; bb.Size=UDim2.fromOffset(200,40); bb.StudsOffset=Vector3.new(0,3,0); bb.AlwaysOnTop=true; bb.Adornee=part
	local lbl=Instance.new("TextLabel",bb); lbl.Name="NameLbl"; lbl.Size=UDim2.new(1,0,0,20); lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=color
	lbl.TextStrokeTransparency=0; lbl.TextStrokeColor3=Color3.new(0,0,0); lbl.TextSize=14; lbl.Font=Enum.Font.GothamBold
	local dL=Instance.new("TextLabel",bb); dL.Name="DistLbl"; dL.Size=UDim2.new(1,0,0,16); dL.Position=UDim2.new(0,0,0,22); dL.BackgroundTransparency=1
	dL.Text="---"; dL.TextColor3=Color3.new(1,1,1); dL.TextStrokeTransparency=0; dL.TextStrokeColor3=Color3.new(0,0,0); dL.TextSize=12; dL.Font=Enum.Font.GothamBold
	bb.Parent=part
end
local function removeESP(model)
	if not model then return end
	for _,c in ipairs(model:GetChildren()) do if c.Name:find("ESP_HL") then c:Destroy() end end
	for _,p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then for _,t in ipairs(p:GetChildren()) do if t.Name:find("ESP_Tag") then t:Destroy() end end end end
end
local C_Pri,C_Orng,C_Red,C_Pur,C_Grn,C_Yel,C_Cyn=Color3.fromRGB(255,145,80),Color3.fromRGB(255,165,0),Color3.fromRGB(255,100,110),Color3.fromRGB(191,90,242),Color3.fromRGB(110,220,140),Color3.fromRGB(255,210,110),Color3.fromRGB(110,200,245)

task.spawn(function() while not State.Unloaded do task.wait(OC.CandyInterval)
	if OC.AutoCollectCandy and hasChar() then
		antiDetect.Running=true; local items=getCI()
		if #items>0 then
			local hrp=getHRP(); for _,d in ipairs(items) do d.dist=(d.part.Position-hrp.Position).Magnitude end
			table.sort(items,function(a,b) return a.dist<b.dist end)
			local c=0
			for _,d in ipairs(items) do
				if not hasChar() or c>=10 then break end
				if OC.CandyMethod=="path" then ocWalk(d.part,OC.CandyTimeout,OC.CandyWalkSpeed)
				elseif d.dist>5 then ocWalk(d.part,OC.CandyTimeout,OC.CandyWalkSpeed) end
				task.wait(0.15); OC.Stats.ItemsAttempted+=1
				local cl=collectItem(d)
				if not cl then task.wait(0.2); cl=collectItem(d) end
				if cl and not d.model.Parent then
					if not countedItems[d.model] then countedItems[d.model]=true; OC.Stats.ItemsCollected+=1; OC.Stats.CandiesCollected+=1 end
					c+=1; task.wait(0.2)
				end
			end
		end
		antiDetect.Running=false
	end
end end)
task.spawn(function() while not State.Unloaded do task.wait(OC.PumpkinInterval)
	if OC.AutoCollectPumpkin and hasChar() then
		antiDetect.Running=true; local pk=getCP()
		if #pk>0 then
			local hrp=getHRP(); for _,d in ipairs(pk) do d.dist=(d.part.Position-hrp.Position).Magnitude end
			table.sort(pk,function(a,b) return a.dist<b.dist end)
			local c=0
			for _,d in ipairs(pk) do
				if not hasChar() or c>=10 then break end
				if OC.PumpkinMethod=="path" then ocWalk(d.part,OC.CandyTimeout,OC.CandyWalkSpeed)
				elseif d.dist>5 then ocWalk(d.part,OC.CandyTimeout,OC.CandyWalkSpeed) end
				task.wait(0.15); OC.Stats.PumpkinsAttempted+=1
				local cl=collectItem(d)
				if not cl then task.wait(0.2); cl=collectItem(d) end
				if cl and not d.model.Parent then
					if not countedPumpkins[d.model] then countedPumpkins[d.model]=true; OC.Stats.PumpkinsCollected+=1 end
					c+=1; task.wait(0.2)
				end
			end
		end
		antiDetect.Running=false
	end
end end)
task.spawn(function() while not State.Unloaded do task.wait(3)
	OC.Stats.ItemsFound=#getCI(); OC.Stats.PumpkinsFound=#getCP()
	for m in pairs(countedItems) do if not m.Parent then countedItems[m]=nil end end
	for m in pairs(countedPumpkins) do if not m.Parent then countedPumpkins[m]=nil end end
end end)

task.spawn(function() while not State.Unloaded do task.wait(2)
	if OC.ItemESP then
		local items=getCI(); local cur={}
		for _,d in ipairs(items) do cur[d.model]=d end
		for m in pairs(itemCache) do if not cur[m] or not m.Parent then removeESP(m); itemCache[m]=nil end end
		for m,d in pairs(cur) do if not itemCache[m] then createHL(m,C_Pri,"ItemESP_HL"); createTag(d.part,m.Name,C_Pri,"ItemESP_Tag"); itemCache[m]=d end end
	elseif next(itemCache) then for m in pairs(itemCache) do removeESP(m) end; itemCache={} end
	if OC.PumpkinESP then
		local pk=getCP(); local cur={}
		for _,d in ipairs(pk) do cur[d.model]=d end
		for m in pairs(pumpkinCache) do if not cur[m] or not m.Parent then removeESP(m); pumpkinCache[m]=nil end end
		for m,d in pairs(cur) do if not pumpkinCache[m] then createHL(m,C_Orng,"PumpkinESP_HL"); createTag(d.part,m.Name,C_Orng,"PumpkinESP_Tag"); pumpkinCache[m]=d end end
	elseif next(pumpkinCache) then for m in pairs(pumpkinCache) do removeESP(m) end; pumpkinCache={} end
	if OC.ReaperESP then
		local rs=scanReapers(); OC.Stats.ReapersFound=#rs; local cur={}
		for _,d in ipairs(rs) do cur[d.model]=d end
		for m in pairs(reaperCache) do if not cur[m] or not m.Parent then removeESP(m); reaperCache[m]=nil end end
		for m,d in pairs(cur) do if not reaperCache[m] then createHL(m,C_Red,"ReaperESP_HL"); createTag(d.part,m.Name,C_Red,"ReaperESP_Tag"); reaperCache[m]=d end end
	elseif next(reaperCache) then for m in pairs(reaperCache) do removeESP(m) end; reaperCache={} end
	if OC.GhostESP then
		local gs=scanGhosts(); OC.Stats.GhostsFound=#gs; local cur={}
		for _,d in ipairs(gs) do cur[d.model]=d end
		for m in pairs(ghostCache) do if not cur[m] or not m.Parent then removeESP(m); ghostCache[m]=nil end end
		for m,d in pairs(cur) do if not ghostCache[m] then createHL(m,C_Pur,"GhostESP_HL"); createTag(d.part,d.name,C_Pur,"GhostESP_Tag"); ghostCache[m]=d end end
	elseif next(ghostCache) then for m in pairs(ghostCache) do removeESP(m) end; ghostCache={} end
end end)
task.spawn(function() while not State.Unloaded do task.wait(1)
	if OC.ShowDistance and hasChar() then
		local hrp=getHRP()
		local function upd(cache,tag,base)
			for m,d in pairs(cache) do if d.part and d.part.Parent then
				local ds=(d.part.Position-hrp.Position).Magnitude
				local bb=d.part:FindFirstChild(tag)
				if bb then local dl=bb:FindFirstChild("DistLbl")
					if dl then local c=base; if ds>200 then c=C_Yel elseif ds>500 then c=C_Red end
						dl.Text=math.floor(ds).." studs"; dl.TextColor3=c end end
			end end
		end
		upd(itemCache,"ItemESP_Tag",C_Grn); upd(pumpkinCache,"PumpkinESP_Tag",C_Orng); upd(reaperCache,"ReaperESP_Tag",C_Red); upd(ghostCache,"GhostESP_Tag",C_Cyn)
	end
end end)

OC.ServerHop=function()
	local ok,servers=pcall(function() return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")) end)
	if ok and servers and servers.data then
		local candidates={}
		for _,s in ipairs(servers.data) do if s.playing<s.maxPlayers and s.id~=game.JobId then table.insert(candidates,s.id) end end
		if #candidates>0 then
			local target=candidates[math.random(1,#candidates)]
			pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId,target,localPlayer) end)
		end
	end
end
OC.Unload=function()
	if OC.Fly then stopFly() end
	for m in pairs(itemCache) do removeESP(m) end
	for m in pairs(pumpkinCache) do removeESP(m) end
	for m in pairs(reaperCache) do removeESP(m) end
	for m in pairs(ghostCache) do removeESP(m) end
	Lighting.Brightness=origBrightness; Lighting.FogEnd=origFogEnd
	if env.Oc1DvHUB==OC then env.Oc1DvHUB=nil end
end
env.Oc1DvHUB = OC
print("[Oc1DvHUB] Engine loaded (noclip-aware walk).")

