end)
task.spawn(function()
	while not State.Unloaded do task.wait(0.5)
		if OC.GodMode and hasChar() then local h=getHum(); if h and h.Health<h.MaxHealth then pcall(function() h.Health=h.MaxHealth end) end end
	end
end)

UIS.JumpRequest:Connect(function()
	if OC.InfiniteJump and hasChar() then local h=getHum(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end
end)

local origBrightness,origFogEnd=Lighting.Brightness,Lighting.FogEnd
task.spawn(function()
	while not State.Unloaded do
		task.wait(0.5)
		if OC.Fullbright then Lighting.Brightness=3; Lighting.ClockTime=12; Lighting.Ambient=Color3.fromRGB(200,200,200) else Lighting.Brightness=origBrightness end
		if OC.NoFog then Lighting.FogEnd=1e6; Lighting.FogStart=1e6 else Lighting.FogEnd=origFogEnd end
