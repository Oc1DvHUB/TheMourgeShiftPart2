		if OC.SpeedhackEnabled then local h=getHum(); if h then pcall(function() h.WalkSpeed=OC.SpeedhackValue end) end
		elseif OC.WalkSpeedEnabled then local h=getHum(); if h and math.abs(h.WalkSpeed-OC.WalkSpeedValue)>0.5 then h.WalkSpeed=OC.WalkSpeedValue end end
