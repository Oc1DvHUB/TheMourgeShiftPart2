			if OC.Invisible then p.LocalTransparencyModifier=1 else p.LocalTransparencyModifier=0 end
			if State.Noclip or OC.Invisible or OC.Fly then p.CanCollide=false else p.CanCollide=true end
		end end end
	end
end)
task.spawn(function()
